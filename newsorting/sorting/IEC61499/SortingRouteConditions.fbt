ChooseReady := (Route &gt; 0) AND NOT Fault;
IF Route = 1 THEN ChooseNext := 9; ELSIF Route = 2 THEN ChooseNext := 11; ELSE ChooseNext := 13; END_IF;
RouteReady := ChooseReady AND ((Route = 1 AND B1Open AND B2Closed) OR (Route = 2 AND B1Closed AND B2Open) OR (Route = 3 AND B1Closed AND B2Closed));
ArrivalReady := ((UseArrivalSensor AND Arrival) OR (NOT UseArrivalSensor AND TravelElapsed)) AND NOT Fault;
HomeReady := HomeElapsed AND B1Closed AND B2Closed AND NOT Fault;
IF Automatic THEN EndNext := 2; ELSE EndNext := 15; END_IF;
TravelTime := BlackTime; IF Route = 1 THEN TravelTime := RedTime; ELSIF Route = 2 THEN TravelTime := SilverTime; END_IF;
</ST>
    </Algorithm>
    <Algorithm Name="ON_FAULT">
      <ST>Fault := TRUE;
IF FullActiveHigh THEN Blocked := SlideSignal; ELSE Blocked := NOT SlideSignal; END_IF;
IF (B1Closed AND B1Open) OR (B2Closed AND B2Open) THEN Fault := TRUE; END_IF;
CheckReady := QI AND NOT Fault; IF Blocked THEN CheckNext := 3; ELSE CheckNext := 5; END_IF;
FullWaitReady := FinishElapsed AND NOT Fault; IF Blocked THEN FullWaitNext := 4; ELSE FullWaitNext := 2; END_IF;
AckReady := Acked AND NOT Fault;
WaitReady := QI AND PartAvailable AND NOT Fault;
FeedReady := FeedElapsed AND NOT PartAvailable AND NOT Fault;
SenseReady := SenseElapsed AND NOT Fault;
ChooseReady := (Route &gt; 0) AND NOT Fault;
IF Route = 1 THEN ChooseNext := 9; ELSIF Route = 2 THEN ChooseNext := 11; ELSE ChooseNext := 13; END_IF;
RouteReady := ChooseReady AND ((Route = 1 AND B1Open AND B2Closed) OR (Route = 2 AND B1Closed AND B2Open) OR (Route = 3 AND B1Closed AND B2Closed));
ArrivalReady := ((UseArrivalSensor AND Arrival) OR (NOT UseArrivalSensor AND TravelElapsed)) AND NOT Fault;
HomeReady := HomeElapsed AND B1Closed AND B2Closed AND NOT Fault;
IF Automatic THEN EndNext := 2; ELSE EndNext := 15; END_IF;
TravelTime := BlackTime; IF Route = 1 THEN TravelTime := RedTime; ELSIF Route = 2 THEN TravelTime := SilverTime; END_IF;
</ST>
    </Algorithm>
  </BasicFB>
</FBType>