    <Algorithm Name="ON_INIT">
      <ST>FeedElapsed := FALSE; SenseElapsed := FALSE; FinishElapsed := FALSE; TravelElapsed := FALSE; HomeElapsed := FALSE; Acked := FALSE; Route := 0; Fault := FALSE; Occupied := FALSE; FullLamp := FALSE; WaitingFull := FALSE; CycleEnd := FALSE;
