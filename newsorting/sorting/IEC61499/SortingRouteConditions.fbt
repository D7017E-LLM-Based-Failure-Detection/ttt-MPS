RouteReady := ChooseReady AND ((Route = 1 AND B1Open AND B2Closed) OR (Route = 2 AND B1Closed AND B2Open) OR (Route = 3 AND B1Closed AND B2Closed));
ArrivalReady := ((UseArrivalSensor AND Arrival) OR (NOT UseArrivalSensor AND TravelElapsed)) AND NOT Fault;
HomeReady := HomeElapsed AND B1Closed AND B2Closed AND NOT Fault;
IF Automatic THEN EndNext := 2; ELSE EndNext := 15; END_IF;
TravelTime := BlackTime; IF Route = 1 THEN TravelTime := RedTime; ELSIF Route = 2 THEN TravelTime := SilverTime; END_IF;
</ST>
