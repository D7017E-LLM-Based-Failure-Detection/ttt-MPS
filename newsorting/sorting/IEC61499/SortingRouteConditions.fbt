IF (B1Closed AND B1Open) OR (B2Closed AND B2Open) THEN Fault := TRUE; END_IF;
CheckReady := QI AND NOT Fault; IF Blocked THEN CheckNext := 3; ELSE CheckNext := 5; END_IF;
