    <Algorithm Name="INITIALIZE">
      <ST>
State := SE.App2StateManagement.OpState#PhaseStopped; Ready := FALSE; AutoMode := Automatic; Action := 0; Requested := 0;

StartFlag := FALSE; StartLamp := FALSE; ResetLamp := TRUE;</ST>
    </Algorithm>
    <Algorithm Name="ON_REQ">
      <ST>Requested := OperatorCmd;
Action := 0;
IF Requested = 2 AND WaitingFull AND State = SE.App2StateManagement.OpState#PhaseExecute THEN Action := 9;
ELSIF Requested = 3 OR Requested = 4 OR Requested = 6 OR Requested = 8 THEN IF State &lt;&gt; SE.App2StateManagement.OpState#PhaseStopping THEN Action := 3; END_IF;
ELSIF Requested = 1 AND RunPermit THEN IF State = SE.App2StateManagement.OpState#PhaseStopped OR State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 1; END_IF;
ELSIF Requested = 2 AND Ready AND RunPermit AND NOT Fault AND State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 2;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="ON_HMI_CMD">
      <ST>Requested := HMICommand;
Action := 0;
IF Requested = 2 AND WaitingFull AND State = SE.App2StateManagement.OpState#PhaseExecute THEN Action := 9;
ELSIF Requested = 3 OR Requested = 4 OR Requested = 6 OR Requested = 8 THEN IF State &lt;&gt; SE.App2StateManagement.OpState#PhaseStopping THEN Action := 3; END_IF;
ELSIF Requested = 1 AND RunPermit THEN IF State = SE.App2StateManagement.OpState#PhaseStopped OR State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 1; END_IF;
ELSIF Requested = 2 AND Ready AND RunPermit AND NOT Fault AND State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 2;
END_IF;</ST>
    </Algorithm>
    <Algorithm Name="ON_GUARD">
      <ST>Action := 0;
StartLamp := (State = SE.App2StateManagement.OpState#PhaseIdle) OR WaitingFull;
ResetLamp := (State = SE.App2StateManagement.OpState#PhaseStopped) AND NOT Ready;
IF (State = SE.App2StateManagement.OpState#PhaseExecute OR State = SE.App2StateManagement.OpState#PhaseResetting) AND (NOT RunPermit OR Fault) THEN Action := 3; END_IF;</ST>
    </Algorithm>
    <Algorithm Name="ON_RESET_STATE">
      <ST>Action := 0;
IF ResetComplete AND State = SE.App2StateManagement.OpState#PhaseResetting THEN Action := 4;
ELSIF ResetRunning AND State &lt;&gt; SE.App2StateManagement.OpState#PhaseResetting AND State &lt;&gt; SE.App2StateManagement.OpState#PhaseStopping THEN Action := 7; END_IF;</ST>
    </Algorithm>
    <Algorithm Name="ON_CYCLE_STATE">
      <ST>Action := 0;
IF CycleComplete AND State = SE.App2StateManagement.OpState#PhaseExecute THEN Action := 5;
ELSIF CycleRunning AND Ready AND RunPermit AND NOT Fault AND State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 8; END_IF;</ST>
    </Algorithm>
    <Algorithm Name="ON_STOP_STATE">
      <ST>
Action := 0; IF StopComplete AND State = SE.App2StateManagement.OpState#PhaseStopping THEN Action := 6; END_IF;
</ST>
    </Algorithm>
    <Algorithm Name="SET_MODE">
      <ST>
AutoMode := HMIAutomatic;
</ST>
    </Algorithm>
    <Algorithm Name="RESET">
      <ST>
State := SE.App2StateManagement.OpState#PhaseResetting; Ready := FALSE;

StartFlag := FALSE; StartLamp := FALSE; ResetLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="RUN">
      <ST>
State := SE.App2StateManagement.OpState#PhaseExecute;

StartFlag := TRUE; StartLamp := FALSE; ResetLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="STOP">
      <ST>
State := SE.App2StateManagement.OpState#PhaseStopping; Ready := FALSE;

StartFlag := FALSE; StartLamp := FALSE; ResetLamp := TRUE;</ST>
    </Algorithm>
    <Algorithm Name="RESET_DONE">
      <ST>
State := SE.App2StateManagement.OpState#PhaseIdle; Ready := TRUE;

StartFlag := FALSE; StartLamp := TRUE; ResetLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="RUN_DONE">
      <ST>
State := SE.App2StateManagement.OpState#PhaseIdle; Ready := TRUE;

StartFlag := FALSE; StartLamp := TRUE; ResetLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="STOP_DONE">
      <ST>
State := SE.App2StateManagement.OpState#PhaseStopped; Ready := FALSE;

StartFlag := FALSE; StartLamp := FALSE; ResetLamp := TRUE;</ST>
    </Algorithm>
    <Algorithm Name="NOP">
      <ST>Action := Action;</ST>
    </Algorithm>
    <Algorithm Name="RESET_OBSERVED">
      <ST>State := SE.App2StateManagement.OpState#PhaseResetting; Ready := FALSE; StartFlag := FALSE; ResetLamp := FALSE; StartLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="RUN_OBSERVED">
      <ST>State := SE.App2StateManagement.OpState#PhaseExecute; StartFlag := TRUE; StartLamp := FALSE; ResetLamp := FALSE;</ST>
    </Algorithm>
    <Algorithm Name="ACKNOWLEDGE">
      <ST>Action := 0;</ST>
    </Algorithm>
    <Algorithm Name="ON_START_REQUEST">
      <ST>Requested := 2;
Action := 0;
IF Requested = 2 AND WaitingFull AND State = SE.App2StateManagement.OpState#PhaseExecute THEN Action := 9;
ELSIF Requested = 3 OR Requested = 4 OR Requested = 6 OR Requested = 8 THEN IF State &lt;&gt; SE.App2StateManagement.OpState#PhaseStopping THEN Action := 3; END_IF;
ELSIF Requested = 1 AND RunPermit THEN IF State = SE.App2StateManagement.OpState#PhaseStopped OR State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 1; END_IF;
ELSIF Requested = 2 AND Ready AND RunPermit AND NOT Fault AND State = SE.App2StateManagement.OpState#PhaseIdle THEN Action := 2;
END_IF;</ST>
    </Algorithm>
  </BasicFB>
</FBType>