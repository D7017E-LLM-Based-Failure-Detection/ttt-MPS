<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="333d6cb0-959d-411f-afe3-43aecbb61f9b" Name="Actuator" Format="2.0" Comment="Composite Function Block Type" Namespace="Flexbridge.FestoMPS400">
  <Attribute Name="HMI.Alias" Value="" />
  <Attribute Name="Configuration.FB.IDCounter" Value="28" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="1.0.1" Author="ApplicationLibDevTeam" Date="10/17/2023" Remarks="First Version" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_SUPPRESS_ALM" Comment="Request to update the alarm suppress status">
        <With Var="SuppressAlarm" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution confirmation">
        <With Var="FbClosed" />
        <With Var="FbOpened" />
      </Event>
      <Event Name="CNF_ALARM" Comment="Execution confirmation of alarm">
        <With Var="FbAlarm" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="SuppressAlarm" Type="BOOL" Comment="1 = Suppress alarm in HMI" />
      <VarDeclaration Name="ActiveStateSel" Type="ActiveState" Namespace="SE.App2Base" Comment="Feedback type selection to determine the active state for valves [StateSel configured as Valve1Op or Valve2Op],  0 = Open State  1 = Closed State " />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="FbClosed" Type="BOOL" Comment="1 = Closed" />
      <VarDeclaration Name="FbOpened" Type="BOOL" Comment="1 = Opened" />
      <VarDeclaration Name="FbAlarm" Type="BOOL" Comment="1 = Feedback failure alarm is active" />
    </OutputVars>
    <AdapterInputs>
      <Adapter Name="IRsp" Type="IDigital" Namespace="SE.App2Base" Comment="Program remote setpoint interface adapter" />
      <Adapter Name="ISc" Type="IDevice" Namespace="SE.App2CommonProcess" Comment="Sequence control Interface adapter. Controls the block when owner is in program local" />
      <Adapter Name="IIlck" Type="IOpCondS" Namespace="SE.App2CommonProcess" Comment="Interlock condition summary chain input from ilckCondItem blocks" />
      <Adapter Name="IPerm" Type="IOpPermS" Namespace="SE.App2CommonProcess" Comment="Permission condition summary chain input from permCondItem blocks" />
    </AdapterInputs>
    <AdapterOutputs>
      <Adapter Name="IFbState" Type="IDigital" Namespace="SE.App2Base" Comment="Current feedback status adapter(Bit 2 = Feedback failure status)" />
    </AdapterOutputs>
  </InterfaceList>
  <FBNetwork>
