        <ECAction Algorithm="algS_C_RAISE" Output="HMI_ST" />
        <ECAction Output="ILift.REQ_CMD" />
      </ECState>
      <ECState Name="C_C_RAISE" x="9300" y="700">
        <ECAction Algorithm="algC_C_RAISE" />
      </ECState>
      <ECState Name="W_C_RAISE" Comment="Wait: Raise lift" x="9300" y="1100" />
      <ECState Name="S_C_HEIGHT" x="10200" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_HEIGHT" Output="HMI_ST" />
      </ECState>
      <ECState Name="S_C_PUSH" x="11100" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_PUSH" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
        <ECAction Output="IAirSlide.REQ_CMD" />
        <ECAction Output="TSTART_EJ" />
      </ECState>
      <ECState Name="W_C_PUSH" Comment="Wait: Push onto air slide" x="11100" y="700" />
      <ECState Name="K_C_PUSH" x="11100" y="1100">
        <ECAction Algorithm="algFaultOnly" />
      </ECState>
      <ECState Name="S_C_BACK" x="12000" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_BACK" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
      </ECState>
      <ECState Name="C_C_BACK" x="12000" y="700">
        <ECAction Algorithm="algC_C_BACK" />
      </ECState>
      <ECState Name="W_C_BACK" Comment="Wait: Ejector back" x="12000" y="1100" />
      <ECState Name="S_C_SLIDE" x="12900" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_SLIDE" Output="HMI_ST" />
        <ECAction Output="TSTART_SL" />
      </ECState>
      <ECState Name="W_C_SLIDE" Comment="Wait: Air slide on" x="12900" y="700" />
      <ECState Name="K_C_SLIDE" x="12900" y="1100">
        <ECAction Algorithm="algFaultOnly" />
      </ECState>
      <ECState Name="S_C_LOWER" x="13800" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_LOWER" Output="HMI_ST" />
        <ECAction Output="IAirSlide.REQ_CMD" />
        <ECAction Output="ILift.REQ_CMD" />
      </ECState>
      <ECState Name="C_C_LOWER" x="13800" y="700">
        <ECAction Algorithm="algC_C_LOWER" />
      </ECState>
      <ECState Name="W_C_LOWER" Comment="Wait: Air off, lift down" x="13800" y="1100" />
      <ECState Name="S_C_DONE" x="14700" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_DONE" Output="HMI_ST" />
        <ECAction Output="RELEASE" />
      </ECState>
      <ECState Name="S_X_LOWER" x="15600" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_X_LOWER" Output="HMI_ST" />
        <ECAction Output="ILift.REQ_CMD" />
      </ECState>
      <ECState Name="C_X_LOWER" x="15600" y="700">
        <ECAction Algorithm="algC_X_LOWER" />
      </ECState>
      <ECState Name="W_X_LOWER" Comment="Wait: Reject: lift down" x="15600" y="1100" />
      <ECState Name="S_X_EJ" x="16500" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_X_EJ" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
        <ECAction Output="TSTART_EJ" />
      </ECState>
      <ECState Name="W_X_EJ" Comment="Wait: Reject: eject" x="16500" y="700" />
      <ECState Name="K_X_EJ" x="16500" y="1100">
        <ECAction Algorithm="algFaultOnly" />
      </ECState>
      <ECState Name="S_X_BACK" x="17400" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_X_BACK" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
      </ECState>
      <ECState Name="C_X_BACK" x="17400" y="700">
        <ECAction Algorithm="algC_X_BACK" />
      </ECState>
      <ECState Name="W_X_BACK" Comment="Wait: Reject: ejector back" x="17400" y="1100" />
      <ECState Name="S_X_COUNT" x="18300" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_X_COUNT" Output="HMI_ST" />
      </ECState>
      <ECState Name="FAULT_S" Comment="Fault: RESET restarts the reset sequence after Rearm on the faceplate" x="19200" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algFault" Output="HMI_ST" />
        <ECAction Output="FAULT" />
      </ECState>
      <ECState Name="SR_Lift" Comment="Lift ready before INIT" x="100" y="2900">
        <ECAction Algorithm="algRdyLift" />
      </ECState>
      <ECState Name="TR_Lift" x="100" y="3300">
        <ECAction Algorithm="algRdyLift" />
      </ECState>
      <ECState Name="TK_Lift" Comment="Start-up takeover of Lift" x="100" y="3700" />
      <ECState Name="TS_Lift" x="-200" y="4100">
        <ECAction Algorithm="algTkSelLift" Output="ILift.REQ_PROGLOCALSEL" />
      </ECState>
      <ECState Name="TC_Lift" x="400" y="4100">
        <ECAction Algorithm="algTkCmdLift" Output="ILift.REQ_CMD" />
      </ECState>
      <ECTransition Source="START" Destination="INIT_S" Condition="INIT" x="150" y="300" />
      <ECTransition Source="INIT_S" Destination="S_IDLE" Condition="1" x="150" y="700" />
      <ECTransition Source="S_IDLE" Destination="TK_Lift" Condition="1" x="150" y="1100" />
      <ECTransition Source="IDLE_W" Destination="INIT_S" Condition="INIT" x="250" y="900" />
      <ECTransition Source="IDLE_W" Destination="M_IDLE" Condition="MODE" x="150" y="1500" />
      <ECTransition Source="M_IDLE" Destination="IDLE_W" Condition="1" x="250" y="1500" />
      <ECTransition Source="IDLE_W" Destination="S_R_SEL" Condition="DO_RESET" x="400" y="1300" />
      <ECTransition Source="IDLE_W" Destination="Q_TRAY" Condition="TRAY" x="350" y="1500" />
      <ECTransition Source="IDLE_W" Destination="Q_EMPTY" Condition="SIM_EMPTY" x="350" y="1800" />
      <ECTransition Source="IDLE_W" Destination="Q_FULL" Condition="SIM_FULL" x="350" y="2100" />
      <ECTransition Source="Q_TRAY" Destination="Q_CHK" Condition="1" x="700" y="1900" />
      <ECTransition Source="Q_EMPTY" Destination="Q_CHK" Condition="1" x="700" y="2100" />
      <ECTransition Source="Q_FULL" Destination="Q_CHK" Condition="1" x="700" y="2300" />
      <ECTransition Source="Q_CHK" Destination="Q_NOSTART" Condition="NOT Accept" x="950" y="2300" />
      <ECTransition Source="Q_NOSTART" Destination="IDLE_W" Condition="1" x="600" y="1300" />
      <ECTransition Source="Q_CHK" Destination="FAULT_S" Condition="Accept AND Fault" x="1100" y="2100" />
      <ECTransition Source="Q_CHK" Destination="S_C_PASS" Condition="Accept AND NOT Fault AND Full" x="1100" y="2000" />
      <ECTransition Source="Q_CHK" Destination="S_C_REQ" Condition="Accept AND NOT Fault AND NOT Full" x="1100" y="2200" />
      <ECTransition Source="S_R_SEL" Destination="C_R_SEL" Condition="1" x="2150" y="500" />
      <ECTransition Source="C_R_SEL" Destination="FAULT_S" Condition="Fault" x="2400" y="750" />
      <ECTransition Source="C_R_SEL" Destination="S_R_HOME" Condition="NOT Fault AND Done" x="2400" y="650" />
      <ECTransition Source="C_R_SEL" Destination="W_R_SEL" Condition="NOT Fault AND NOT Done" x="2150" y="900" />
      <ECTransition Source="W_R_SEL" Destination="C_R_SEL" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="2250" y="900" />
      <ECTransition Source="S_R_HOME" Destination="C_R_HOME" Condition="1" x="3050" y="500" />
      <ECTransition Source="C_R_HOME" Destination="FAULT_S" Condition="Fault" x="3300" y="750" />
      <ECTransition Source="C_R_HOME" Destination="S_R_EJ" Condition="NOT Fault AND Done" x="3300" y="650" />
      <ECTransition Source="C_R_HOME" Destination="W_R_HOME" Condition="NOT Fault AND NOT Done" x="3050" y="900" />
      <ECTransition Source="W_R_HOME" Destination="C_R_HOME" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="3150" y="900" />
      <ECTransition Source="S_R_EJ" Destination="W_R_EJ" Condition="1" x="3950" y="500" />
