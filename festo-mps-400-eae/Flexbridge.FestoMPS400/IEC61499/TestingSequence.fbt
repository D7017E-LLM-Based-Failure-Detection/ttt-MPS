      <ECTransition Source="K_R_EJ" Destination="FAULT_S" Condition="Fault" x="4200" y="1100" />
      <ECTransition Source="K_R_EJ" Destination="W_R_EJ" Condition="NOT Fault" x="4050" y="900" />
      <ECTransition Source="S_R_BACK" Destination="C_R_BACK" Condition="1" x="4850" y="500" />
      <ECTransition Source="C_R_BACK" Destination="FAULT_S" Condition="Fault" x="5100" y="750" />
      <ECTransition Source="C_R_BACK" Destination="S_R_DONE" Condition="NOT Fault AND Done" x="5100" y="650" />
      <ECTransition Source="C_R_BACK" Destination="W_R_BACK" Condition="NOT Fault AND NOT Done" x="4850" y="900" />
      <ECTransition Source="W_R_BACK" Destination="C_R_BACK" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="4950" y="900" />
      <ECTransition Source="S_R_DONE" Destination="IDLE_W" Condition="1" x="5750" y="500" />
      <ECTransition Source="S_C_PASS" Destination="IDLE_W" Condition="1" x="6650" y="500" />
      <ECTransition Source="S_C_REQ" Destination="W_C_REQ" Condition="1" x="7550" y="500" />
      <ECTransition Source="W_C_REQ" Destination="S_C_COLOUR" Condition="WP_CNF" x="7800" y="700" />
      <ECTransition Source="W_C_REQ" Destination="K_C_REQ" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="7550" y="900" />
      <ECTransition Source="K_C_REQ" Destination="FAULT_S" Condition="Fault" x="7800" y="1100" />
      <ECTransition Source="K_C_REQ" Destination="W_C_REQ" Condition="NOT Fault" x="7650" y="900" />
      <ECTransition Source="S_C_COLOUR" Destination="S_X_EJ" Condition="Black" x="8450" y="500" />
      <ECTransition Source="S_C_COLOUR" Destination="S_C_RAISE" Condition="NOT Black" x="8450" y="500" />
      <ECTransition Source="S_C_RAISE" Destination="C_C_RAISE" Condition="1" x="9350" y="500" />
      <ECTransition Source="C_C_RAISE" Destination="FAULT_S" Condition="Fault" x="9600" y="750" />
      <ECTransition Source="C_C_RAISE" Destination="S_C_HEIGHT" Condition="NOT Fault AND Done" x="9600" y="650" />
      <ECTransition Source="C_C_RAISE" Destination="W_C_RAISE" Condition="NOT Fault AND NOT Done" x="9350" y="900" />
      <ECTransition Source="W_C_RAISE" Destination="C_C_RAISE" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="9450" y="900" />
      <ECTransition Source="S_C_HEIGHT" Destination="S_C_PUSH" Condition="HeightGood" x="10250" y="500" />
      <ECTransition Source="S_C_HEIGHT" Destination="S_X_LOWER" Condition="NOT HeightGood" x="10250" y="500" />
      <ECTransition Source="S_C_PUSH" Destination="W_C_PUSH" Condition="1" x="11150" y="500" />
      <ECTransition Source="W_C_PUSH" Destination="S_C_BACK" Condition="T_EJ" x="11400" y="700" />
      <ECTransition Source="W_C_PUSH" Destination="K_C_PUSH" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="11150" y="900" />
      <ECTransition Source="K_C_PUSH" Destination="FAULT_S" Condition="Fault" x="11400" y="1100" />
      <ECTransition Source="K_C_PUSH" Destination="W_C_PUSH" Condition="NOT Fault" x="11250" y="900" />
      <ECTransition Source="S_C_BACK" Destination="C_C_BACK" Condition="1" x="12050" y="500" />
      <ECTransition Source="C_C_BACK" Destination="FAULT_S" Condition="Fault" x="12300" y="750" />
      <ECTransition Source="C_C_BACK" Destination="S_C_SLIDE" Condition="NOT Fault AND Done" x="12300" y="650" />
      <ECTransition Source="C_C_BACK" Destination="W_C_BACK" Condition="NOT Fault AND NOT Done" x="12050" y="900" />
      <ECTransition Source="W_C_BACK" Destination="C_C_BACK" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="12150" y="900" />
      <ECTransition Source="S_C_SLIDE" Destination="W_C_SLIDE" Condition="1" x="12950" y="500" />
      <ECTransition Source="W_C_SLIDE" Destination="S_C_LOWER" Condition="T_SL" x="13200" y="700" />
      <ECTransition Source="W_C_SLIDE" Destination="K_C_SLIDE" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="12950" y="900" />
      <ECTransition Source="K_C_SLIDE" Destination="FAULT_S" Condition="Fault" x="13200" y="1100" />
      <ECTransition Source="K_C_SLIDE" Destination="W_C_SLIDE" Condition="NOT Fault" x="13050" y="900" />
      <ECTransition Source="S_C_LOWER" Destination="C_C_LOWER" Condition="1" x="13850" y="500" />
      <ECTransition Source="C_C_LOWER" Destination="FAULT_S" Condition="Fault" x="14100" y="750" />
      <ECTransition Source="C_C_LOWER" Destination="S_C_DONE" Condition="NOT Fault AND Done" x="14100" y="650" />
      <ECTransition Source="C_C_LOWER" Destination="W_C_LOWER" Condition="NOT Fault AND NOT Done" x="13850" y="900" />
      <ECTransition Source="W_C_LOWER" Destination="C_C_LOWER" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="13950" y="900" />
      <ECTransition Source="S_C_DONE" Destination="IDLE_W" Condition="1" x="14750" y="500" />
      <ECTransition Source="S_X_LOWER" Destination="C_X_LOWER" Condition="1" x="15650" y="500" />
      <ECTransition Source="C_X_LOWER" Destination="FAULT_S" Condition="Fault" x="15900" y="750" />
      <ECTransition Source="C_X_LOWER" Destination="S_X_EJ" Condition="NOT Fault AND Done" x="15900" y="650" />
      <ECTransition Source="C_X_LOWER" Destination="W_X_LOWER" Condition="NOT Fault AND NOT Done" x="15650" y="900" />
      <ECTransition Source="W_X_LOWER" Destination="C_X_LOWER" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="15750" y="900" />
      <ECTransition Source="S_X_EJ" Destination="W_X_EJ" Condition="1" x="16550" y="500" />
      <ECTransition Source="W_X_EJ" Destination="S_X_BACK" Condition="T_EJ" x="16800" y="700" />
      <ECTransition Source="W_X_EJ" Destination="K_X_EJ" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="16550" y="900" />
      <ECTransition Source="K_X_EJ" Destination="FAULT_S" Condition="Fault" x="16800" y="1100" />
      <ECTransition Source="K_X_EJ" Destination="W_X_EJ" Condition="NOT Fault" x="16650" y="900" />
      <ECTransition Source="S_X_BACK" Destination="C_X_BACK" Condition="1" x="17450" y="500" />
      <ECTransition Source="C_X_BACK" Destination="FAULT_S" Condition="Fault" x="17700" y="750" />
      <ECTransition Source="C_X_BACK" Destination="S_X_COUNT" Condition="NOT Fault AND Done" x="17700" y="650" />
      <ECTransition Source="C_X_BACK" Destination="W_X_BACK" Condition="NOT Fault AND NOT Done" x="17450" y="900" />
      <ECTransition Source="W_X_BACK" Destination="C_X_BACK" Condition="ILift.CNF_STATUS OR ILift.CNF_READY OR IEjector.CNF_STATUS OR IEjector.CNF_READY OR IAirSlide.CNF_STATUS OR IAirSlide.CNF_READY" x="17550" y="900" />
      <ECTransition Source="S_X_COUNT" Destination="S_C_REQ" Condition="1" x="18350" y="500" />
      <ECTransition Source="FAULT_S" Destination="IDLE_W" Condition="1" x="19250" y="500" />
      <ECTransition Source="START" Destination="SR_Lift" Condition="ILift.CNF_READY" x="100" y="2700" />
      <ECTransition Source="SR_Lift" Destination="START" Condition="1" x="200" y="2800" />
      <ECTransition Source="IDLE_W" Destination="TR_Lift" Condition="ILift.CNF_READY" x="0" y="3100" />
      <ECTransition Source="TR_Lift" Destination="TK_Lift" Condition="1" x="150" y="3500" />
      <ECTransition Source="IDLE_W" Destination="TK_Lift" Condition="ILift.CNF_STATUS" x="-100" y="3500" />
      <ECTransition Source="TK_Lift" Destination="TS_Lift" Condition="NOT AdpLift AND RdyLift AND NOT ILift.ProgLocal AND TryLift &lt; 3" x="-100" y="3900" />
      <ECTransition Source="TK_Lift" Destination="TC_Lift" Condition="NOT AdpLift AND RdyLift AND ILift.ProgLocal AND (ILift.Status.value = 1 OR ILift.Status.value = 2)" x="300" y="3900" />
      <ECTransition Source="TK_Lift" Destination="IDLE_W" Condition="NOT (NOT AdpLift AND RdyLift AND NOT ILift.ProgLocal AND TryLift &lt; 3) AND NOT (NOT AdpLift AND RdyLift AND ILift.ProgLocal AND (ILift.Status.value = 1 OR ILift.Status.value = 2))" x="150" y="4000" />
      <ECTransition Source="TS_Lift" Destination="IDLE_W" Condition="1" x="-200" y="4300" />
      <ECTransition Source="TC_Lift" Destination="IDLE_W" Condition="1" x="400" y="4300" />
    </ECC>
    <Algorithm Name="algModeText" Comment="Station mode as text">
      <ST><![CDATA[CASE Mode OF
    0: ModeText := 'Wait for RESET';
    1: ModeText := 'Resetting';
    2: ModeText := 'Wait for START';
    3: ModeText := 'Started';
ELSE
    ModeText := 'Unknown mode';
END_CASE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algInit" Comment="Idle">
      <ST><![CDATA[QO := QI;
StepNo := 0; StepText := '0 Idle';
Cycles := 0; Rejected := 0; TrayReleased := FALSE;
Done := FALSE; Fault := FALSE;
AdpLift := FALSE; TryLift := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="algIdle" Comment="Idle">
      <ST><![CDATA[StepNo := 0; StepText := '0 Idle';
]]></ST>
    </Algorithm>
    <Algorithm Name="algFaultOnly" Comment="Fault check while waiting for a timer or a confirmation">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
]]></ST>
    </Algorithm>
    <Algorithm Name="algQTray" Comment="Tray state from the waypoint">
      <ST><![CDATA[TrayNow := Tray; Full := Workpiece;
]]></ST>
    </Algorithm>
    <Algorithm Name="algQEmpty" Comment="Stand-in: empty tray">
      <ST><![CDATA[TrayNow := TRUE; Full := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algQFull" Comment="Stand-in: tray with a workpiece">
      <ST><![CDATA[TrayNow := TRUE; Full := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algQ_CHK" Comment="Tray: accept only when started; all devices must be ready">
      <ST><![CDATA[Accept := Started AND TrayNow;
Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset OR NOT (ILift.ProgLocal AND IEjector.ProgLocal AND IAirSlide.ProgLocal);
IF NOT Started THEN
    StepText := '0 Idle: press START first';
ELSIF NOT TrayNow THEN
    StepText := '0 Idle: no tray';
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_SEL" Comment="Reset: owners to program">
      <ST><![CDATA[StepNo := 10; StepText := '10 Reset: owners to program';
ILift.ProgLocalSel := TRUE;
IEjector.ProgLocalSel := TRUE;
IAirSlide.ProgLocalSel := TRUE;
AdpLift := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_R_SEL" Comment="Check: Reset: owners to program">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := ILift.ProgLocal AND IEjector.ProgLocal AND IAirSlide.ProgLocal;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_HOME" Comment="Reset: air off, lift down">
      <ST><![CDATA[StepNo := 11; StepText := '11 Reset: air off, lift down';
IAirSlide.Lsp.value := 0;
ILift.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_R_HOME" Comment="Check: Reset: air off, lift down">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := ILift.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_EJ" Comment="Reset: eject">
      <ST><![CDATA[StepNo := 12; StepText := '12 Reset: eject';
IEjector.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_BACK" Comment="Reset: ejector back">
      <ST><![CDATA[StepNo := 13; StepText := '13 Reset: ejector back';
IEjector.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_R_BACK" Comment="Check: Reset: ejector back">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := IEjector.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_DONE" Comment="Reset done">
      <ST><![CDATA[StepNo := 14; StepText := '14 Reset done';
TrayReleased := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_PASS" Comment="Tray full: released">
      <ST><![CDATA[StepNo := 20; StepText := '20 Tray full: released';
TrayReleased := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_REQ" Comment="Ask Distributing">
      <ST><![CDATA[StepNo := 21; StepText := '21 Ask Distributing';
TrayReleased := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_COLOUR" Comment="Check colour">
      <ST><![CDATA[StepNo := 22; StepText := '22 Check colour';
Black := NOT NotBlackPv.value;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_RAISE" Comment="Raise lift">
      <ST><![CDATA[StepNo := 23; StepText := '23 Raise lift';
ILift.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_RAISE" Comment="Check: Raise lift">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := ILift.Status.value = 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_HEIGHT" Comment="Check height">
      <ST><![CDATA[StepNo := 24; StepText := '24 Check height';
HeightGood := HeightOkPv.value;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_PUSH" Comment="Push onto air slide">
      <ST><![CDATA[StepNo := 25; StepText := '25 Push onto air slide';
IEjector.Lsp.value := 1;
IAirSlide.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_BACK" Comment="Ejector back">
      <ST><![CDATA[StepNo := 26; StepText := '26 Ejector back';
IEjector.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_BACK" Comment="Check: Ejector back">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := IEjector.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_SLIDE" Comment="Air slide on">
      <ST><![CDATA[StepNo := 27; StepText := '27 Air slide on';
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_LOWER" Comment="Air off, lift down">
      <ST><![CDATA[StepNo := 28; StepText := '28 Air off, lift down';
IAirSlide.Lsp.value := 0;
ILift.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_LOWER" Comment="Check: Air off, lift down">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := ILift.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_DONE" Comment="Done: tray released">
      <ST><![CDATA[StepNo := 29; StepText := '29 Done: tray released';
Cycles := Cycles + 1;
TrayReleased := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_X_LOWER" Comment="Reject: lift down">
      <ST><![CDATA[StepNo := 32; StepText := '32 Reject: lift down';
ILift.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_X_LOWER" Comment="Check: Reject: lift down">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := ILift.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_X_EJ" Comment="Reject: eject">
      <ST><![CDATA[StepNo := 30; StepText := '30 Reject: eject';
IEjector.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_X_BACK" Comment="Reject: ejector back">
      <ST><![CDATA[StepNo := 31; StepText := '31 Reject: ejector back';
IEjector.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_X_BACK" Comment="Check: Reject: ejector back">
      <ST><![CDATA[Fault := ILift.NeedReset OR IEjector.NeedReset OR IAirSlide.NeedReset;
Done := IEjector.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_X_COUNT" Comment="Rejected: ask again">
      <ST><![CDATA[StepNo := 33; StepText := '33 Rejected: ask again';
Rejected := Rejected + 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algFault" Comment="Device fault: stop here, report to StationMode">
      <ST><![CDATA[StepNo := 99;
IF ILift.NeedReset THEN
    StepText := '99 FAULT: Rearm Lift';
ELSIF IEjector.NeedReset THEN
    StepText := '99 FAULT: Rearm Ejector';
ELSIF IAirSlide.NeedReset THEN
    StepText := '99 FAULT: Rearm AirSlide';
ELSE
    StepText := '99 FAULT: owner not program';
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="algRdyLift" Comment="Lift has reported ready">
      <ST><![CDATA[RdyLift := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algTkSelLift" Comment="Start-up: ask Lift for program local">
      <ST><![CDATA[ILift.ProgLocalSel := TRUE;
TryLift := TryLift + 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algTkCmdLift" Comment="Start-up: command the end position Lift reports (it does not move)">
      <ST><![CDATA[ILift.Lsp.value := ILift.Status.value;
AdpLift := TRUE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
