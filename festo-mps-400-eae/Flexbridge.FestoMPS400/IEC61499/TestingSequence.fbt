<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd" >
<FBType Name="TestingSequence" Namespace="Flexbridge.FestoMPS400" GUID="c0689e0b-a7ae-41d2-8061-1ba84c8d31a4" Comment="Basic Function Block Type" >
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Flexbridge AB" Version="0.0" Author="Sandeep Patil" Date="11/16/2026" Remarks="Template" />
  <CompilerInfo />
  <InterfaceList>
    <EventInputs>
      <Event ID="6491447AA107ED7D" Name="INIT" Comment="Initialisation request">
        <With Var="QI" />
      </Event>
      <Event ID="E9D3978CBF4E1C7C" Name="MODE" Comment="Station mode changed (StationMode)">
        <With Var="Mode" />
        <With Var="Started" />
      </Event>
      <Event ID="404EEB99E842A269" Name="DO_RESET" Comment="Run the reset sequence (StationMode)">
      </Event>
      <Event ID="A0FA5D33EBAEE13D" Name="TRAY" Comment="Tray state at interface 1 (conveyor waypoint, IWaypoint)">
        <With Var="Tray" />
        <With Var="Workpiece" />
      </Event>
      <Event ID="99C1D4CAA8E589B4" Name="SIM_EMPTY" Comment="Stand-in: an empty tray has arrived (HMI button)">
      </Event>
      <Event ID="6EF7EFA72D6EF7A1" Name="SIM_FULL" Comment="Stand-in: a tray with a workpiece has arrived (HMI button)">
      </Event>
      <Event ID="CE103A6FE02EB000" Name="WP_CNF" Comment="Distributing has handed a workpiece over (IWorkpieceSupply)">
      </Event>
      <Event ID="7A64A6579328FF4D" Name="SENS" Comment="Colour or height sensor changed">
        <With Var="NotBlackPv" />
        <With Var="HeightOkPv" />
      </Event>
      <Event ID="8E4813D1C7842188" Name="T_EJ" Comment="Ejector time over (EjectTimer)">
      </Event>
      <Event ID="A56E83D77C8EC629" Name="T_SL" Comment="Air slide time over (SlideTimer)">
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="C882617665E13E09" Name="INITO" Comment="Initialisation confirm">
        <With Var="QO" />
      </Event>
      <Event ID="BA6F71BB111389B6" Name="RESET_DONE" Comment="Reset sequence finished (StationMode)">
      </Event>
      <Event ID="AD818ACDC0589534" Name="FAULT" Comment="Stopped on a device fault (StationMode)">
      </Event>
      <Event ID="DFF8B512080D88F4" Name="WP_REQ" Comment="Ask Distributing for a workpiece (IWorkpieceSupply)">
      </Event>
      <Event ID="E108CB526FBA8331" Name="RELEASE" Comment="Release the tray (IWaypoint)">
      </Event>
      <Event ID="CF5A7E56D46470E9" Name="STATE_REQ" Comment="Ask the waypoint for the tray state (IWaypoint)">
      </Event>
      <Event ID="26F48BE458D4A159" Name="TSTART_EJ" Comment="Start the ejector timer">
      </Event>
      <Event ID="3F572A3C1D9074EF" Name="TSTART_SL" Comment="Start the air slide timer">
      </Event>
      <Event ID="A58B0990CCDD3855" Name="HMI_ST" Comment="State for the HMI">
        <With Var="ModeText" />
        <With Var="StepText" />
        <With Var="Cycles" />
        <With Var="Rejected" />
        <With Var="StepNo" />
        <With Var="TrayReleased" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="C4C11FDFE1382B30" Name="QI" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration ID="330C3923E87968EE" Name="Mode" Type="INT" Comment="Station mode: 0 = wait for RESET, 1 = resetting, 2 = wait for START, 3 = started" />
      <VarDeclaration ID="D1B46B5E8753AE36" Name="Started" Type="BOOL" Comment="Station started: trays are accepted" />
      <VarDeclaration ID="387D6851593C63B9" Name="Tray" Type="BOOL" Comment="A tray is at the stopper of interface 1" />
      <VarDeclaration ID="F7325DDC33AB364F" Name="Workpiece" Type="BOOL" Comment="The tray carries a workpiece" />
      <VarDeclaration ID="6AD516F989FD7533" Name="NotBlackPv" Type="VTQBOOL" Comment="B2 workpiece is not black" />
      <VarDeclaration ID="025262918B7AB4C1" Name="HeightOkPv" Type="VTQBOOL" Comment="Height comparator: height correct" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="4C4FC604D6B6E770" Name="QO" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration ID="6D6D41DA60BF85A2" Name="ModeText" Type="STRING[40]" Comment="Station mode as text" />
      <VarDeclaration ID="50A0ACBB08EFF850" Name="StepText" Type="STRING[40]" Comment="Current step as text (number and name)" />
      <VarDeclaration ID="C7ACEDB01AE67EA5" Name="Cycles" Type="UDINT" Comment="Workpieces put on a tray since start-up" />
      <VarDeclaration ID="658AE5D5259A2BD9" Name="Rejected" Type="UDINT" Comment="Workpieces rejected (black or wrong height) since start-up" />
      <VarDeclaration ID="3B0AEE5029ED66BF" Name="StepNo" Type="INT" Comment="Current step number" />
      <VarDeclaration ID="D4E332979929154E" Name="TrayReleased" Type="BOOL" Comment="The tray has been released (until the next tray)" />
    </OutputVars>
    <Plugs>
      <AdapterDeclaration Name="ILift" Type="IDevice" Namespace="SE.App2CommonProcess" />
      <AdapterDeclaration Name="IEjector" Type="IDevice" Namespace="SE.App2CommonProcess" />
      <AdapterDeclaration Name="IAirSlide" Type="IDevice" Namespace="SE.App2CommonProcess" />
    </Plugs>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algModeText,algInit,algIdle,algFaultOnly,algQTray,algQEmpty,algQFull,algQ_CHK,algS_R_SEL,algC_R_SEL,algS_R_HOME,algC_R_HOME,algS_R_EJ,algS_R_BACK,algC_R_BACK,algS_R_DONE,algS_C_PASS,algS_C_REQ,algS_C_COLOUR,algS_C_RAISE,algC_C_RAISE,algS_C_HEIGHT,algS_C_PUSH,algS_C_BACK,algC_C_BACK,algS_C_SLIDE,algS_C_LOWER,algC_C_LOWER,algS_C_DONE,algS_X_LOWER,algC_X_LOWER,algS_X_EJ,algS_X_BACK,algC_X_BACK,algS_X_COUNT,algFault,algRdyLift,algTkSelLift,algTkCmdLift" />
    <InternalVars>
      <VarDeclaration Name="Done" Type="BOOL" Comment="The current step has reached its target" />
      <VarDeclaration Name="Fault" Type="BOOL" Comment="A device needs Rearm, or is not program local when it must be" />
      <VarDeclaration Name="Accept" Type="BOOL" Comment="A tray is accepted (station started, tray present)" />
      <VarDeclaration Name="TrayNow" Type="BOOL" Comment="A tray is present (from the waypoint or a stand-in button)" />
      <VarDeclaration Name="Full" Type="BOOL" Comment="The present tray carries a workpiece" />
      <VarDeclaration Name="Black" Type="BOOL" Comment="The workpiece is black" />
      <VarDeclaration Name="HeightGood" Type="BOOL" Comment="The workpiece has the right height" />
      <VarDeclaration Name="RdyLift" Type="BOOL" Comment="Lift has sent CNF_READY: its owner has initialised" />
      <VarDeclaration Name="AdpLift" Type="BOOL" Comment="Lift taken over at start-up, or the reset sequence has run" />
      <VarDeclaration Name="TryLift" Type="INT" Comment="Program-local requests sent to Lift at start-up" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial state" x="100" y="100" />
      <ECState Name="INIT_S" x="100" y="500">
        <ECAction Algorithm="algInit" />
        <ECAction Algorithm="algModeText" />
        <ECAction Output="HMI_ST" />
        <ECAction Output="INITO" />
      </ECState>
      <ECState Name="S_IDLE" x="100" y="900">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algIdle" Output="HMI_ST" />
      </ECState>
      <ECState Name="IDLE_W" Comment="Idle: wait for RESET (reset sequence) or a tray" x="100" y="1300" />
      <ECState Name="M_IDLE" x="100" y="1700">
        <ECAction Algorithm="algModeText" Output="HMI_ST" />
      </ECState>
      <ECState Name="Q_TRAY" x="500" y="1700">
        <ECAction Algorithm="algQTray" />
      </ECState>
      <ECState Name="Q_EMPTY" x="500" y="2100">
        <ECAction Algorithm="algQEmpty" />
      </ECState>
      <ECState Name="Q_FULL" x="500" y="2500">
        <ECAction Algorithm="algQFull" />
      </ECState>
      <ECState Name="Q_CHK" x="900" y="2100">
        <ECAction Algorithm="algQ_CHK" />
      </ECState>
      <ECState Name="Q_NOSTART" x="900" y="2500">
        <ECAction Algorithm="algModeText" Output="HMI_ST" />
      </ECState>
      <ECState Name="S_R_SEL" x="2100" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_R_SEL" Output="HMI_ST" />
        <ECAction Output="ILift.REQ_PROGLOCALSEL" />
        <ECAction Output="IEjector.REQ_PROGLOCALSEL" />
        <ECAction Output="IAirSlide.REQ_PROGLOCALSEL" />
      </ECState>
      <ECState Name="C_R_SEL" x="2100" y="700">
        <ECAction Algorithm="algC_R_SEL" />
      </ECState>
      <ECState Name="W_R_SEL" Comment="Wait: Reset: owners to program" x="2100" y="1100" />
      <ECState Name="S_R_HOME" x="3000" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_R_HOME" Output="HMI_ST" />
        <ECAction Output="IAirSlide.REQ_CMD" />
        <ECAction Output="ILift.REQ_CMD" />
      </ECState>
      <ECState Name="C_R_HOME" x="3000" y="700">
        <ECAction Algorithm="algC_R_HOME" />
      </ECState>
      <ECState Name="W_R_HOME" Comment="Wait: Reset: air off, lift down" x="3000" y="1100" />
      <ECState Name="S_R_EJ" x="3900" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_R_EJ" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
        <ECAction Output="TSTART_EJ" />
      </ECState>
      <ECState Name="W_R_EJ" Comment="Wait: Reset: eject" x="3900" y="700" />
      <ECState Name="K_R_EJ" x="3900" y="1100">
        <ECAction Algorithm="algFaultOnly" />
      </ECState>
      <ECState Name="S_R_BACK" x="4800" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_R_BACK" Output="HMI_ST" />
        <ECAction Output="IEjector.REQ_CMD" />
      </ECState>
      <ECState Name="C_R_BACK" x="4800" y="700">
        <ECAction Algorithm="algC_R_BACK" />
      </ECState>
      <ECState Name="W_R_BACK" Comment="Wait: Reset: ejector back" x="4800" y="1100" />
      <ECState Name="S_R_DONE" x="5700" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_R_DONE" Output="HMI_ST" />
        <ECAction Output="RESET_DONE" />
        <ECAction Output="STATE_REQ" />
      </ECState>
      <ECState Name="S_C_PASS" x="6600" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_PASS" Output="HMI_ST" />
        <ECAction Output="RELEASE" />
      </ECState>
      <ECState Name="S_C_REQ" x="7500" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_REQ" Output="HMI_ST" />
        <ECAction Output="WP_REQ" />
      </ECState>
      <ECState Name="W_C_REQ" Comment="Wait: Ask Distributing" x="7500" y="700" />
      <ECState Name="K_C_REQ" x="7500" y="1100">
        <ECAction Algorithm="algFaultOnly" />
      </ECState>
      <ECState Name="S_C_COLOUR" x="8400" y="300">
        <ECAction Algorithm="algModeText" />
        <ECAction Algorithm="algS_C_COLOUR" Output="HMI_ST" />
      </ECState>
      <ECState Name="S_C_RAISE" x="9300" y="300">
