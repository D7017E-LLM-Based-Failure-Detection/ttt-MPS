    <FB ID="17" UID="6" Name="sc" Type="valve2OpSeqData" x="2840" y="5880" Namespace="SE.App2CommonProcess" />
    <FB ID="9" Name="fbOpen" Type="dISignal" x="2840" y="500" Namespace="SE.App2Base">
      <Attribute Name="Configuration.Component.HideUnusedPorts" Value="" />
      <Parameter Name="$Name" Value="'$${PATH}DIn'" />
    </FB>
    <FB ID="11" Name="cmdOpen" Type="dOSignal" x="9660" y="839.9999" Namespace="SE.App2Base">
      <Attribute Name="Configuration.Component.HideUnusedPorts" Value="" />
