      <ECTransition Source="C_C_GRIP" Destination="W_C_GRIP" Condition="NOT Fault AND NOT Done" x="11150" y="900" />
      <ECTransition Source="W_C_GRIP" Destination="C_C_GRIP" Condition="IEjector.CNF_STATUS OR IEjector.CNF_READY OR IVacuum.CNF_STATUS OR IVacuum.CNF_READY OR ISwivel.CNF_STATUS OR ISwivel.CNF_READY" x="11250" y="900" />
      <ECTransition Source="S_C_TODOWN" Destination="C_C_TODOWN" Condition="1" x="12050" y="500" />
      <ECTransition Source="C_C_TODOWN" Destination="FAULT_S" Condition="Fault" x="12300" y="750" />
      <ECTransition Source="C_C_TODOWN" Destination="S_C_REL" Condition="NOT Fault AND Done" x="12300" y="650" />
      <ECTransition Source="C_C_TODOWN" Destination="W_C_TODOWN" Condition="NOT Fault AND NOT Done" x="12050" y="900" />
      <ECTransition Source="W_C_TODOWN" Destination="C_C_TODOWN" Condition="IEjector.CNF_STATUS OR IEjector.CNF_READY OR IVacuum.CNF_STATUS OR IVacuum.CNF_READY OR ISwivel.CNF_STATUS OR ISwivel.CNF_READY" x="12150" y="900" />
      <ECTransition Source="S_C_REL" Destination="W_C_REL" Condition="1" x="12950" y="500" />
      <ECTransition Source="W_C_REL" Destination="S_C_VACOFF" Condition="TIMEOUT" x="13200" y="700" />
      <ECTransition Source="W_C_REL" Destination="K_C_REL" Condition="IEjector.CNF_STATUS OR IEjector.CNF_READY OR IVacuum.CNF_STATUS OR IVacuum.CNF_READY OR ISwivel.CNF_STATUS OR ISwivel.CNF_READY" x="12950" y="900" />
      <ECTransition Source="K_C_REL" Destination="FAULT_S" Condition="Fault" x="13200" y="1100" />
      <ECTransition Source="K_C_REL" Destination="W_C_REL" Condition="NOT Fault" x="13050" y="900" />
      <ECTransition Source="S_C_VACOFF" Destination="S_P_MAG" Condition="1" x="13850" y="500" />
      <ECTransition Source="S_C_DONE" Destination="IDLE_W" Condition="1" x="14750" y="500" />
      <ECTransition Source="FAULT_S" Destination="IDLE_W" Condition="1" x="15650" y="500" />
      <ECTransition Source="START" Destination="SR_Swivel" Condition="ISwivel.CNF_READY" x="100" y="2100" />
      <ECTransition Source="SR_Swivel" Destination="START" Condition="1" x="200" y="2200" />
      <ECTransition Source="IDLE_W" Destination="TR_Swivel" Condition="ISwivel.CNF_READY" x="0" y="2500" />
      <ECTransition Source="TR_Swivel" Destination="TK_Swivel" Condition="1" x="150" y="2900" />
      <ECTransition Source="IDLE_W" Destination="TK_Swivel" Condition="ISwivel.CNF_STATUS" x="-100" y="2900" />
      <ECTransition Source="TK_Swivel" Destination="TS_Swivel" Condition="NOT AdpSwivel AND RdySwivel AND NOT ISwivel.ProgLocal AND TrySwivel &lt; 3" x="-100" y="3300" />
      <ECTransition Source="TK_Swivel" Destination="TC_Swivel" Condition="NOT AdpSwivel AND RdySwivel AND ISwivel.ProgLocal AND (ISwivel.Status.value = 1 OR ISwivel.Status.value = 2)" x="300" y="3300" />
      <ECTransition Source="TK_Swivel" Destination="IDLE_W" Condition="NOT (NOT AdpSwivel AND RdySwivel AND NOT ISwivel.ProgLocal AND TrySwivel &lt; 3) AND NOT (NOT AdpSwivel AND RdySwivel AND ISwivel.ProgLocal AND (ISwivel.Status.value = 1 OR ISwivel.Status.value = 2))" x="150" y="3400" />
      <ECTransition Source="TS_Swivel" Destination="IDLE_W" Condition="1" x="-200" y="3700" />
      <ECTransition Source="TC_Swivel" Destination="IDLE_W" Condition="1" x="400" y="3700" />
    </ECC>
    <Algorithm Name="algModeText" Comment="Station mode as text">
      <ST><![CDATA[CASE Mode OF
    0: ModeText := 'Wait for RESET';
    1: ModeText := 'Resetting';
    2: ModeText := 'Wait for START';
    3: ModeText := 'Started';
ELSE
    ModeText := 'Unknown mode';
END_CASE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algInit" Comment="Idle; lamps Q1 and Q2 off">
      <ST><![CDATA[QO := QI;
StepNo := 0; StepText := '0 Idle';
Waiting := FALSE; Q1Lamp := FALSE; Q2Lamp := FALSE;
InCycle := FALSE; Done := FALSE; Fault := FALSE;
Cycles := 0;
AdpSwivel := FALSE; TrySwivel := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="algIdle" Comment="Idle">
      <ST><![CDATA[StepNo := 0; StepText := '0 Idle';
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_SEL" Comment="Reset: owners to program">
      <ST><![CDATA[StepNo := 10; StepText := '10 Reset: owners to program';
IEjector.ProgLocalSel := TRUE;
IVacuum.ProgLocalSel := TRUE;
ISwivel.ProgLocalSel := TRUE;
InCycle := FALSE; Waiting := FALSE; Q1Lamp := FALSE;
AdpSwivel := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_R_SEL" Comment="Check: Reset: owners to program">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := IEjector.ProgLocal AND IVacuum.ProgLocal AND ISwivel.ProgLocal;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_HOME" Comment="Reset: ejector home">
      <ST><![CDATA[StepNo := 11; StepText := '11 Reset: ejector home';
IVacuum.Lsp.value := 0;
IEjector.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_R_HOME" Comment="Check: Reset: ejector home">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := IEjector.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_P_MAG" Comment="Park: swivel to magazine">
      <ST><![CDATA[StepNo := 20; StepText := '20 Park: swivel to magazine';
ISwivel.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_P_MAG" Comment="Check: Park: swivel to magazine">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := ISwivel.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_P_OFF" Comment="Park: off the magazine">
      <ST><![CDATA[StepNo := 21; StepText := '21 Park: off the magazine';
ISwivel.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_P_OFF" Comment="Check: Park: off the magazine">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := ISwivel.Status.value <> 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_P_STOP" Comment="Park: swivel stopped">
      <ST><![CDATA[StepNo := 22; StepText := '22 Park: swivel stopped';
ISwivel.Lsp.value := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_R_DONE" Comment="Reset done">
      <ST><![CDATA[StepNo := 12; StepText := '12 Reset done';
]]></ST>
    </Algorithm>
    <Algorithm Name="algQ_CHK" Comment="Workpiece request: accept only when started and all devices ready">
      <ST><![CDATA[Accept := Started;
Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset OR NOT (IEjector.ProgLocal AND IVacuum.ProgLocal AND ISwivel.ProgLocal);
IF NOT Accept THEN
    StepText := '0 Idle: press START first';
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_MAG" Comment="Cycle: wait while the magazine is empty">
      <ST><![CDATA[InCycle := TRUE;
Waiting := MagEmptyPv.value;
Q1Lamp := Waiting;
IF Waiting THEN
    StepNo := 31; StepText := '31 Wait: magazine empty';
ELSE
    StepNo := 31; StepText := '31 Magazine: workpiece there';
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_PUSH" Comment="Push workpiece out">
      <ST><![CDATA[StepNo := 32; StepText := '32 Push workpiece out';
IEjector.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_PUSH" Comment="Check: Push workpiece out">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := IEjector.Status.value = 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_BACK" Comment="Ejector back home">
      <ST><![CDATA[StepNo := 33; StepText := '33 Ejector back home';
IEjector.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_BACK" Comment="Check: Ejector back home">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := IEjector.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_TOMAG" Comment="Swivel to magazine">
      <ST><![CDATA[StepNo := 34; StepText := '34 Swivel to magazine';
ISwivel.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_TOMAG" Comment="Check: Swivel to magazine">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := ISwivel.Status.value = 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_GRIP" Comment="Vacuum on, wait gripped">
      <ST><![CDATA[StepNo := 35; StepText := '35 Vacuum on, wait gripped';
IVacuum.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_GRIP" Comment="Check: Vacuum on, wait gripped">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := IVacuum.Status.value = 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_TODOWN" Comment="Swivel to Testing">
      <ST><![CDATA[StepNo := 36; StepText := '36 Swivel to Testing';
ISwivel.Lsp.value := 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algC_C_TODOWN" Comment="Check: Swivel to Testing">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
Done := ISwivel.Status.value = 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_REL" Comment="Ejection pulse">
      <ST><![CDATA[StepNo := 37; StepText := '37 Release: ejection pulse';
IVacuum.Lsp.value := 2;
]]></ST>
    </Algorithm>
    <Algorithm Name="algK_C_REL" Comment="Fault check while the pulse runs">
      <ST><![CDATA[Fault := IEjector.NeedReset OR IVacuum.NeedReset OR ISwivel.NeedReset;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_VACOFF" Comment="Vacuum off">
      <ST><![CDATA[StepNo := 38; StepText := '38 Vacuum off';
IVacuum.Lsp.value := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="algS_C_DONE" Comment="Cycle done: handed over">
      <ST><![CDATA[StepNo := 40; StepText := '40 Cycle done: handed over';
Cycles := Cycles + 1;
InCycle := FALSE; Waiting := FALSE; Q1Lamp := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algFault" Comment="Device fault: stop here, report to StationMode">
      <ST><![CDATA[StepNo := 99;
IF IEjector.NeedReset THEN
    StepText := '99 FAULT: Rearm Ejector';
ELSIF IVacuum.NeedReset THEN
    StepText := '99 FAULT: Rearm Vacuum';
ELSIF ISwivel.NeedReset THEN
    StepText := '99 FAULT: Rearm Swivel';
ELSE
    StepText := '99 FAULT: owner not program';
END_IF;
InCycle := FALSE; Waiting := FALSE; Q1Lamp := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algRdySwivel" Comment="Swivel has reported ready">
      <ST><![CDATA[RdySwivel := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algTkSelSwivel" Comment="Start-up: ask Swivel for program local">
      <ST><![CDATA[ISwivel.ProgLocalSel := TRUE;
TrySwivel := TrySwivel + 1;
]]></ST>
    </Algorithm>
    <Algorithm Name="algTkCmdSwivel" Comment="Start-up: command the end position Swivel reports (it does not move)">
      <ST><![CDATA[ISwivel.Lsp.value := ISwivel.Status.value;
AdpSwivel := TRUE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
