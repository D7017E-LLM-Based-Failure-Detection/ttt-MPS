      <ECTransition Source="W_C_TOMAG" Destination="C_C_TOMAG" Condition="IEjector.CNF_STATUS OR IEjector.CNF_READY OR IVacuum.CNF_STATUS OR IVacuum.CNF_READY OR ISwivel.CNF_STATUS OR ISwivel.CNF_READY" x="10350" y="900" />
