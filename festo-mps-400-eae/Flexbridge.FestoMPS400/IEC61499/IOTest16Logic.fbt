        <ECAction Algorithm="algDI" Output="HMI_DI" />
      </ECState>
      <ECState Name="CMD_S" x="1600" y="1000">
        <ECAction Algorithm="algCmd" />
      </ECState>
      <ECState Name="OFF_S" x="1600" y="1400">
        <ECAction Algorithm="algAllOff" />
      </ECState>
      <ECState Name="TO_S" x="1600" y="1800">
        <ECAction Algorithm="algTimeout" />
      </ECState>
      <ECState Name="OUT_S" x="2800" y="1400">
        <ECAction Algorithm="algUpdate" Output="DO_UPD" />
        <ECAction Output="HMI_DO" />
      </ECState>
      <ECState Name="PSTOP_S" x="4000" y="1200">
        <ECAction Output="TSTOP" />
      </ECState>
      <ECState Name="PSTART_S" x="4000" y="1700">
        <ECAction Output="TSTART" />
      </ECState>
      <ECTransition Source="START" Destination="INIT_S" Condition="INIT" x="1000.0" y="700.0" />
      <ECTransition Source="INIT_S" Destination="START" Condition="1" x="1000.0" y="700.0" />
      <ECTransition Source="START" Destination="DI_S" Condition="DI" x="1000.0" y="900.0" />
      <ECTransition Source="DI_S" Destination="START" Condition="1" x="1000.0" y="900.0" />
      <ECTransition Source="START" Destination="CMD_S" Condition="CMD" x="1000.0" y="1100.0" />
      <ECTransition Source="CMD_S" Destination="OUT_S" Condition="Changed" x="2200.0" y="1200.0" />
      <ECTransition Source="CMD_S" Destination="START" Condition="NOT Changed" x="1000.0" y="1100.0" />
      <ECTransition Source="START" Destination="OFF_S" Condition="ALL_OFF" x="1000.0" y="1300.0" />
      <ECTransition Source="OFF_S" Destination="OUT_S" Condition="1" x="2200.0" y="1400.0" />
      <ECTransition Source="START" Destination="TO_S" Condition="PULSE_END" x="1000.0" y="1500.0" />
      <ECTransition Source="TO_S" Destination="OUT_S" Condition="Changed" x="2200.0" y="1600.0" />
      <ECTransition Source="TO_S" Destination="START" Condition="NOT Changed" x="1000.0" y="1500.0" />
      <ECTransition Source="OUT_S" Destination="PSTOP_S" Condition="StopPulse" x="3400.0" y="1300.0" />
      <ECTransition Source="OUT_S" Destination="PSTART_S" Condition="StartPulse AND NOT StopPulse" x="3400.0" y="1550.0" />
      <ECTransition Source="OUT_S" Destination="START" Condition="NOT StartPulse AND NOT StopPulse" x="1600.0" y="1300.0" />
      <ECTransition Source="PSTOP_S" Destination="PSTART_S" Condition="StartPulse" x="4000.0" y="1450.0" />
      <ECTransition Source="PSTOP_S" Destination="START" Condition="NOT StartPulse" x="2200.0" y="1200.0" />
      <ECTransition Source="PSTART_S" Destination="START" Condition="1" x="2200.0" y="1450.0" />
    </ECC>
    <Algorithm Name="algInit">
      <ST><![CDATA[(* All outputs off, no pulse running *)
St00 := FALSE;
PrevRq00 := FALSE;
St01 := FALSE;
PrevRq01 := FALSE;
St02 := FALSE;
PrevRq02 := FALSE;
St03 := FALSE;
PrevRq03 := FALSE;
St04 := FALSE;
PrevRq04 := FALSE;
St05 := FALSE;
PrevRq05 := FALSE;
St06 := FALSE;
PrevRq06 := FALSE;
St07 := FALSE;
PrevRq07 := FALSE;
St08 := FALSE;
PrevRq08 := FALSE;
St09 := FALSE;
PrevRq09 := FALSE;
St10 := FALSE;
PrevRq10 := FALSE;
St11 := FALSE;
PrevRq11 := FALSE;
St12 := FALSE;
PrevRq12 := FALSE;
St13 := FALSE;
PrevRq13 := FALSE;
St14 := FALSE;
PrevRq14 := FALSE;
St15 := FALSE;
PrevRq15 := FALSE;
PulseCh := -1;
Changed := FALSE;
StartPulse := FALSE;
StopPulse := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algDI">
      <ST><![CDATA[(* Copy the input values for the HMI *)
Di00 := In00.value;
Di01 := In01.value;
Di02 := In02.value;
Di03 := In03.value;
Di04 := In04.value;
Di05 := In05.value;
Di06 := In06.value;
Di07 := In07.value;
Di08 := In08.value;
Di09 := In09.value;
Di10 := In10.value;
Di11 := In11.value;
Di12 := In12.value;
Di13 := In13.value;
Di14 := In14.value;
Di15 := In15.value;
]]></ST>
    </Algorithm>
    <Algorithm Name="algCmd">
      <ST><![CDATA[VAR
  aSt : ARRAY[0..15] OF BOOL;
  aRq : ARRAY[0..15] OF BOOL;
  aPr : ARRAY[0..15] OF BOOL;
  aEx : ARRAY[0..15] OF INT;
  aPu : ARRAY[0..15] OF TIME;
  i : INT;
  p : INT;
  allowed : BOOL;
END_VAR
aSt[0] := St00;
aSt[1] := St01;
aSt[2] := St02;
aSt[3] := St03;
aSt[4] := St04;
aSt[5] := St05;
aSt[6] := St06;
aSt[7] := St07;
aSt[8] := St08;
aSt[9] := St09;
aSt[10] := St10;
aSt[11] := St11;
aSt[12] := St12;
aSt[13] := St13;
aSt[14] := St14;
aSt[15] := St15;
aRq[0] := Cmd00;
aRq[1] := Cmd01;
aRq[2] := Cmd02;
aRq[3] := Cmd03;
aRq[4] := Cmd04;
aRq[5] := Cmd05;
aRq[6] := Cmd06;
aRq[7] := Cmd07;
aRq[8] := Cmd08;
aRq[9] := Cmd09;
aRq[10] := Cmd10;
aRq[11] := Cmd11;
aRq[12] := Cmd12;
aRq[13] := Cmd13;
aRq[14] := Cmd14;
aRq[15] := Cmd15;
aPr[0] := PrevRq00;
aPr[1] := PrevRq01;
aPr[2] := PrevRq02;
aPr[3] := PrevRq03;
aPr[4] := PrevRq04;
aPr[5] := PrevRq05;
aPr[6] := PrevRq06;
aPr[7] := PrevRq07;
aPr[8] := PrevRq08;
aPr[9] := PrevRq09;
aPr[10] := PrevRq10;
aPr[11] := PrevRq11;
aPr[12] := PrevRq12;
aPr[13] := PrevRq13;
aPr[14] := PrevRq14;
aPr[15] := PrevRq15;
aEx[0] := Excl00;
aEx[1] := Excl01;
aEx[2] := Excl02;
aEx[3] := Excl03;
aEx[4] := Excl04;
aEx[5] := Excl05;
aEx[6] := Excl06;
aEx[7] := Excl07;
aEx[8] := Excl08;
aEx[9] := Excl09;
aEx[10] := Excl10;
aEx[11] := Excl11;
aEx[12] := Excl12;
aEx[13] := Excl13;
aEx[14] := Excl14;
aEx[15] := Excl15;
aPu[0] := Pulse00;
aPu[1] := Pulse01;
aPu[2] := Pulse02;
aPu[3] := Pulse03;
aPu[4] := Pulse04;
aPu[5] := Pulse05;
aPu[6] := Pulse06;
aPu[7] := Pulse07;
aPu[8] := Pulse08;
aPu[9] := Pulse09;
aPu[10] := Pulse10;
aPu[11] := Pulse11;
aPu[12] := Pulse12;
aPu[13] := Pulse13;
aPu[14] := Pulse14;
aPu[15] := Pulse15;
Changed := FALSE;
StartPulse := FALSE;
StopPulse := FALSE;
(* Only buttons whose request changed since the last CMD are handled, so a request that was
   refused earlier never switches an output on later by surprise. *)
FOR i := 0 TO 15 DO
  IF aRq[i] <> aPr[i] THEN
    aPr[i] := aRq[i];
    IF aRq[i] <> aSt[i] THEN
      IF NOT aRq[i] THEN
        (* Switching off is always allowed *)
        aSt[i] := FALSE;
        Changed := TRUE;
        IF PulseCh = i THEN
          PulseCh := -1;
          StopPulse := TRUE;
        END_IF;
      ELSE
        (* Switching on: refused while the partner output is on, or while another pulse runs *)
        allowed := TRUE;
        p := aEx[i];
        IF (p >= 0) AND (p <= 15) THEN
          IF aSt[p] THEN
            allowed := FALSE;
          END_IF;
        END_IF;
        IF (aPu[i] > T#0s) AND (PulseCh >= 0) THEN
          allowed := FALSE;
        END_IF;
        IF allowed THEN
          aSt[i] := TRUE;
          Changed := TRUE;
          IF aPu[i] > T#0s THEN
            PulseCh := i;
            PulseDT := aPu[i];
            StartPulse := TRUE;
          END_IF;
        END_IF;
      END_IF;
    END_IF;
  END_IF;
END_FOR;
St00 := aSt[0];
St01 := aSt[1];
St02 := aSt[2];
St03 := aSt[3];
St04 := aSt[4];
St05 := aSt[5];
St06 := aSt[6];
St07 := aSt[7];
St08 := aSt[8];
St09 := aSt[9];
St10 := aSt[10];
St11 := aSt[11];
St12 := aSt[12];
St13 := aSt[13];
St14 := aSt[14];
St15 := aSt[15];
PrevRq00 := aPr[0];
PrevRq01 := aPr[1];
PrevRq02 := aPr[2];
PrevRq03 := aPr[3];
PrevRq04 := aPr[4];
PrevRq05 := aPr[5];
PrevRq06 := aPr[6];
PrevRq07 := aPr[7];
PrevRq08 := aPr[8];
PrevRq09 := aPr[9];
PrevRq10 := aPr[10];
PrevRq11 := aPr[11];
PrevRq12 := aPr[12];
PrevRq13 := aPr[13];
PrevRq14 := aPr[14];
PrevRq15 := aPr[15];
]]></ST>
    </Algorithm>
    <Algorithm Name="algAllOff">
      <ST><![CDATA[(* Switch everything off and cancel a running pulse *)
St00 := FALSE;
St01 := FALSE;
St02 := FALSE;
St03 := FALSE;
St04 := FALSE;
St05 := FALSE;
St06 := FALSE;
St07 := FALSE;
St08 := FALSE;
St09 := FALSE;
St10 := FALSE;
St11 := FALSE;
St12 := FALSE;
St13 := FALSE;
St14 := FALSE;
St15 := FALSE;
StopPulse := (PulseCh >= 0);
PulseCh := -1;
StartPulse := FALSE;
Changed := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algTimeout">
      <ST><![CDATA[VAR
  aSt : ARRAY[0..15] OF BOOL;
END_VAR
aSt[0] := St00;
aSt[1] := St01;
aSt[2] := St02;
aSt[3] := St03;
aSt[4] := St04;
aSt[5] := St05;
aSt[6] := St06;
aSt[7] := St07;
aSt[8] := St08;
aSt[9] := St09;
aSt[10] := St10;
aSt[11] := St11;
aSt[12] := St12;
aSt[13] := St13;
aSt[14] := St14;
aSt[15] := St15;
Changed := FALSE;
StartPulse := FALSE;
StopPulse := FALSE;
IF (PulseCh >= 0) AND (PulseCh <= 15) THEN
  aSt[PulseCh] := FALSE;
  PulseCh := -1;
  Changed := TRUE;
END_IF;
St00 := aSt[0];
St01 := aSt[1];
St02 := aSt[2];
St03 := aSt[3];
St04 := aSt[4];
St05 := aSt[5];
St06 := aSt[6];
St07 := aSt[7];
St08 := aSt[8];
St09 := aSt[9];
St10 := aSt[10];
St11 := aSt[11];
St12 := aSt[12];
St13 := aSt[13];
St14 := aSt[14];
St15 := aSt[15];
]]></ST>
    </Algorithm>
    <Algorithm Name="algUpdate">
      <ST><![CDATA[VAR
  aSt : ARRAY[0..15] OF BOOL;
  aEx : ARRAY[0..15] OF INT;
  aPu : ARRAY[0..15] OF TIME;
  aEn : ARRAY[0..15] OF BOOL;
  i : INT;
  p : INT;
END_VAR
aSt[0] := St00;
aSt[1] := St01;
aSt[2] := St02;
aSt[3] := St03;
aSt[4] := St04;
aSt[5] := St05;
aSt[6] := St06;
aSt[7] := St07;
aSt[8] := St08;
aSt[9] := St09;
aSt[10] := St10;
aSt[11] := St11;
aSt[12] := St12;
aSt[13] := St13;
aSt[14] := St14;
aSt[15] := St15;
aEx[0] := Excl00;
aEx[1] := Excl01;
aEx[2] := Excl02;
aEx[3] := Excl03;
aEx[4] := Excl04;
aEx[5] := Excl05;
aEx[6] := Excl06;
aEx[7] := Excl07;
aEx[8] := Excl08;
aEx[9] := Excl09;
aEx[10] := Excl10;
aEx[11] := Excl11;
aEx[12] := Excl12;
aEx[13] := Excl13;
aEx[14] := Excl14;
aEx[15] := Excl15;
aPu[0] := Pulse00;
aPu[1] := Pulse01;
aPu[2] := Pulse02;
aPu[3] := Pulse03;
aPu[4] := Pulse04;
aPu[5] := Pulse05;
aPu[6] := Pulse06;
aPu[7] := Pulse07;
aPu[8] := Pulse08;
aPu[9] := Pulse09;
aPu[10] := Pulse10;
aPu[11] := Pulse11;
aPu[12] := Pulse12;
aPu[13] := Pulse13;
aPu[14] := Pulse14;
aPu[15] := Pulse15;
(* A button is enabled unless its partner output is on, or it is a pulse output while another pulse runs *)
FOR i := 0 TO 15 DO
  aEn[i] := TRUE;
  p := aEx[i];
  IF (p >= 0) AND (p <= 15) THEN
    IF aSt[p] THEN
      aEn[i] := FALSE;
    END_IF;
  END_IF;
  IF (aPu[i] > T#0s) AND (PulseCh >= 0) AND (PulseCh <> i) THEN
    aEn[i] := FALSE;
  END_IF;
END_FOR;
En00 := aEn[0];
En01 := aEn[1];
En02 := aEn[2];
En03 := aEn[3];
En04 := aEn[4];
En05 := aEn[5];
En06 := aEn[6];
En07 := aEn[7];
En08 := aEn[8];
En09 := aEn[9];
En10 := aEn[10];
En11 := aEn[11];
En12 := aEn[12];
En13 := aEn[13];
En14 := aEn[14];
En15 := aEn[15];
Out00.value := St00;
Out01.value := St01;
Out02.value := St02;
Out03.value := St03;
Out04.value := St04;
Out05.value := St05;
Out06.value := St06;
Out07.value := St07;
Out08.value := St08;
Out09.value := St09;
Out10.value := St10;
Out11.value := St11;
Out12.value := St12;
Out13.value := St13;
Out14.value := St14;
Out15.value := St15;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
