  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="11/22/2026" Remarks="Conveyor CAT with 4 belt outputs and 6 lightweight StopPoints" />
  <InterfaceList>
    <EventInputs>
      <Event ID="D110000000000001" Name="INIT" Comment="Initialization Request">
        <With Var="QI" />
      </Event>
      <Event ID="D110000000000002" Name="REQ" Comment="Normal Execution Request">
        <With Var="QI" />
      </Event>
      <Event ID="D110000000000003" Name="STOP1_TEST_DONE" Comment="Primary Station 1 Testing pass-complete notification for Stop 1" />
      <Event ID="D110000000000004" Name="STOP1_REQ_TRAY" Comment="Request current Station 1 tray and workpiece sensor states" />
      <Event ID="D110000000000005" Name="STOP1_AUTO_REL_UPD" Comment="Update Stop 1 automatic release enable from Station 1">
        <With Var="Stop1AutoRelease" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event ID="D120000000000001" Name="INITO" Comment="Initialization Confirm">
        <With Var="QO" />
      </Event>
      <Event ID="D120000000000002" Name="CNF" Comment="Execution Confirmation">
        <With Var="QO" />
      </Event>
      <Event ID="D120000000000003" Name="STOP1_TRAY_CNF" Comment="Station 1 tray and workpiece sensor update">
        <With Var="Stop1Tray" />
        <With Var="Stop1Workpiece" />
        <With Var="Stop1Pass" />
      </Event>
      <Event ID="D120000000000004" Name="STOP1_REQ_CFG" Comment="Request initial Stop 1 auto-release configuration from Testing on startup" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="D130000000000001" Name="QI" Type="BOOL" InitialValue="TRUE" Comment="Input event qualifier" />
      <VarDeclaration ID="D130000000000002" Name="Stop1AutoRelease" Type="BOOL" InitialValue="FALSE" Comment="Stop 1 automatic release enable (Auto S1 AND Auto-Rel)" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="D140000000000001" Name="QO" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration ID="D140000000000002" Name="Stop1Tray" Type="BOOL" Comment="Tray present at Stop 1 (Station 1)" />
      <VarDeclaration ID="D140000000000003" Name="Stop1Workpiece" Type="BOOL" Comment="Workpiece present on tray at Stop 1 (Station 1)" />
      <VarDeclaration ID="D140000000000004" Name="Stop1Pass" Type="BOOL" Comment="Stopper 1 pass-through or releasing state (TRUE=Down, FALSE=Up/Blocking)" />
    </OutputVars>
  </InterfaceList>
