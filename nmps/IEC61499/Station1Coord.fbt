<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="e1a20006-4c10-4b80-9a10-000000000006" Name="Station1Coord" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author=" " Date="11/25/2026" Remarks="Station 1 (Distribution + Testing) to Conveyor Stop 1 sequential coordinator" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="QI" />
        <With Var="AutoEnable" />
        <With Var="AutoRelease" />
        <With Var="TrayAtStop1" />
        <With Var="PartAtStop1" />
        <With Var="Stop1Pass" />
        <With Var="DistReady" />
        <With Var="TestStopped" />
        <With Var="TestComplete" />
        <With Var="LastPass" />
        <With Var="TestPartPv" />
      </Event>
      <Event Name="REQ_CFG" Comment="AutoEnable or AutoRelease toggle update">
        <With Var="AutoEnable" />
        <With Var="AutoRelease" />
      </Event>
      <Event Name="REQ_TRAY" Comment="Stop 1 tray and workpiece sensor update">
        <With Var="TrayAtStop1" />
        <With Var="PartAtStop1" />
        <With Var="Stop1Pass" />
      </Event>
      <Event Name="REQ_DIST" Comment="Distribution ready state update">
        <With Var="DistReady" />
      </Event>
      <Event Name="REQ_TEST" Comment="Testing cycle state and pass/reject result update">
        <With Var="TestStopped" />
        <With Var="TestComplete" />
        <With Var="LastPass" />
      </Event>
      <Event Name="REQ_TEST_PART" Comment="Testing PartAvailable sensor update">
        <With Var="TestPartPv" />
      </Event>
      <Event Name="REQ_STOP1_CFG" Comment="Re-emit Stop1AutoRelease config on Conveyor startup" />
      <Event Name="ARR_TMR_DONE" Comment="Tray arrival settle timer elapsed" />
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm">
        <With Var="QO" />
        <With Var="Stop1AutoRelease" />
        <With Var="CoordState" />
      </Event>
      <Event Name="START_DIST" Comment="Start Distribution automatic cycle" />
      <Event Name="START_TEST" Comment="Start Testing automatic cycle after Distribution has returned home and parked" />
      <Event Name="TEST_DONE" Comment="Primary Testing pass-complete notification to Conveyor Stop 1" />
      <Event Name="CFG_CNF" Comment="Stop 1 auto-release configuration update">
        <With Var="Stop1AutoRelease" />
      </Event>
      <Event Name="ARR_TMR_START" Comment="Start tray arrival settle debounce timer" />
      <Event Name="ARR_TMR_STOP" Comment="Cancel tray arrival settle debounce timer" />
      <Event Name="STATE_CNF" Comment="Coordinator state update">
        <With Var="CoordState" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="QI" Type="BOOL" InitialValue="TRUE" Comment="Input event qualifier" />
      <VarDeclaration Name="AutoEnable" Type="BOOL" InitialValue="FALSE" Comment="Automatic Station 1 mode enable" />
      <VarDeclaration Name="AutoRelease" Type="BOOL" InitialValue="TRUE" Comment="Auto-release Stop 1 when filled/passing" />
      <VarDeclaration Name="TrayAtStop1" Type="BOOL" InitialValue="FALSE" Comment="Tray present at Stop 1 (M1.DI02)" />
      <VarDeclaration Name="PartAtStop1" Type="BOOL" InitialValue="FALSE" Comment="Workpiece in Station 1 tray pocket (M1.DI05)" />
      <VarDeclaration Name="Stop1Pass" Type="BOOL" InitialValue="FALSE" Comment="Stopper 1 pass-through or releasing state (TRUE=Down, FALSE=Up/Blocking)" />
      <VarDeclaration Name="DistReady" Type="BOOL" InitialValue="FALSE" Comment="Distribution CycleSeq Stopped or Completed" />
      <VarDeclaration Name="TestStopped" Type="BOOL" InitialValue="TRUE" Comment="Testing CycleSeq Stopped state" />
      <VarDeclaration Name="TestComplete" Type="BOOL" InitialValue="FALSE" Comment="Testing CycleSeq Completed state" />
      <VarDeclaration Name="LastPass" Type="BOOL" InitialValue="FALSE" Comment="TRUE if last Testing cycle took the pass branch" />
      <VarDeclaration Name="TestPartPv" Type="VTQBOOL" Comment="Testing PartAvailable sensor process value" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="QO" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration Name="Stop1AutoRelease" Type="BOOL" InitialValue="FALSE" Comment="Effective Stop 1 auto-release enable (AutoEnable AND AutoRelease)" />
      <VarDeclaration Name="CoordState" Type="INT" InitialValue="0" Comment="0=Idle,1=SettleWait,2=RunningDist,3=RunningTest,4=WaitTrayLeave" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="algInit,algArrTmr,algReqCfg,algEval,algClrStartDist,algClrStartTest,algClrTestDone,algClrCfgCnf,algClrArrStart,algClrArrStop" />
    <InternalVars>
      <VarDeclaration Name="state" Type="INT" InitialValue="0" Comment="Internal state machine value" />
      <VarDeclaration Name="traySettled" Type="BOOL" InitialValue="FALSE" Comment="Tray debounce settled at Stop 1" />
      <VarDeclaration Name="seenDistRun" Type="BOOL" InitialValue="FALSE" Comment="Observed Distribution CycleSeq Running since START_DIST" />
      <VarDeclaration Name="seenTestRun" Type="BOOL" InitialValue="FALSE" Comment="Observed Testing CycleSeq Running since START_TEST" />
      <VarDeclaration Name="skipIdle" Type="BOOL" InitialValue="FALSE" Comment="Prevent same-scan restart after manual Stop" />
      <VarDeclaration Name="wantStartDist" Type="BOOL" InitialValue="FALSE" Comment="Pending START_DIST event flag" />
      <VarDeclaration Name="wantStartTest" Type="BOOL" InitialValue="FALSE" Comment="Pending START_TEST event flag" />
      <VarDeclaration Name="wantTestDone" Type="BOOL" InitialValue="FALSE" Comment="Pending TEST_DONE event flag" />
      <VarDeclaration Name="wantCfgCnf" Type="BOOL" InitialValue="FALSE" Comment="Pending CFG_CNF event flag" />
      <VarDeclaration Name="wantArrStart" Type="BOOL" InitialValue="FALSE" Comment="Pending ARR_TMR_START event flag" />
      <VarDeclaration Name="wantArrStop" Type="BOOL" InitialValue="FALSE" Comment="Pending ARR_TMR_STOP event flag" />
    </InternalVars>
    <ECC>
      <ECState Name="START" Comment="Initial State" x="1200" y="900" />
      <ECState Name="DO_INIT" x="1200" y="200">
        <ECAction Algorithm="algInit" Output="INITO" />
        <ECAction Output="CFG_CNF" />
        <ECAction Output="STATE_CNF" />
      </ECState>
      <ECState Name="DO_EVAL" x="2200" y="900">
        <ECAction Algorithm="algEval" Output="STATE_CNF" />
      </ECState>
      <ECState Name="DO_ARR_TMR" x="2200" y="300">
        <ECAction Algorithm="algArrTmr" />
        <ECAction Algorithm="algEval" Output="STATE_CNF" />
      </ECState>
      <ECState Name="DO_REQ_CFG" x="2200" y="1500">
        <ECAction Algorithm="algReqCfg" />
      </ECState>
      <ECState Name="DISPATCH" x="3300" y="900" />
      <ECState Name="EMIT_START_DIST" x="4500" y="200">
        <ECAction Algorithm="algClrStartDist" Output="START_DIST" />
      </ECState>
      <ECState Name="EMIT_START_TEST" x="4500" y="500">
        <ECAction Algorithm="algClrStartTest" Output="START_TEST" />
      </ECState>
      <ECState Name="EMIT_TEST_DONE" x="4500" y="800">
        <ECAction Algorithm="algClrTestDone" Output="TEST_DONE" />
      </ECState>
      <ECState Name="EMIT_CFG_CNF" x="4500" y="1100">
        <ECAction Algorithm="algClrCfgCnf" Output="CFG_CNF" />
      </ECState>
      <ECState Name="EMIT_ARR_START" x="4500" y="1400">
        <ECAction Algorithm="algClrArrStart" Output="ARR_TMR_START" />
      </ECState>
      <ECState Name="EMIT_ARR_STOP" x="4500" y="1700">
        <ECAction Algorithm="algClrArrStop" Output="ARR_TMR_STOP" />
      </ECState>
      <ECTransition Source="START" Destination="DO_INIT" Condition="INIT" x="1200" y="550" />
      <ECTransition Source="DO_INIT" Destination="START" Condition="1" x="1350" y="550" />
      <ECTransition Source="START" Destination="DO_EVAL" Condition="REQ_CFG" x="1700" y="660" />
      <ECTransition Source="START" Destination="DO_EVAL" Condition="REQ_TRAY" x="1700" y="780" />
      <ECTransition Source="START" Destination="DO_EVAL" Condition="REQ_DIST" x="1700" y="900" />
      <ECTransition Source="START" Destination="DO_EVAL" Condition="REQ_TEST" x="1700" y="1020" />
      <ECTransition Source="START" Destination="DO_EVAL" Condition="REQ_TEST_PART" x="1700" y="1140" />
      <ECTransition Source="START" Destination="DO_ARR_TMR" Condition="ARR_TMR_DONE" x="1700" y="450" />
      <ECTransition Source="START" Destination="DO_REQ_CFG" Condition="REQ_STOP1_CFG" x="1700" y="1320" />
      <ECTransition Source="DO_EVAL" Destination="DISPATCH" Condition="1" x="2750" y="900" />
      <ECTransition Source="DO_ARR_TMR" Destination="DISPATCH" Condition="1" x="2750" y="600" />
      <ECTransition Source="DO_REQ_CFG" Destination="DISPATCH" Condition="1" x="2750" y="1200" />
      <ECTransition Source="DISPATCH" Destination="EMIT_START_DIST" Condition="wantStartDist" x="3900" y="500" />
      <ECTransition Source="EMIT_START_DIST" Destination="DISPATCH" Condition="1" x="3900" y="580" />
      <ECTransition Source="DISPATCH" Destination="EMIT_START_TEST" Condition="wantStartTest" x="3900" y="680" />
      <ECTransition Source="EMIT_START_TEST" Destination="DISPATCH" Condition="1" x="3900" y="750" />
      <ECTransition Source="DISPATCH" Destination="EMIT_TEST_DONE" Condition="wantTestDone" x="3900" y="850" />
      <ECTransition Source="EMIT_TEST_DONE" Destination="DISPATCH" Condition="1" x="3900" y="920" />
      <ECTransition Source="DISPATCH" Destination="EMIT_CFG_CNF" Condition="wantCfgCnf" x="3900" y="1020" />
      <ECTransition Source="EMIT_CFG_CNF" Destination="DISPATCH" Condition="1" x="3900" y="1090" />
      <ECTransition Source="DISPATCH" Destination="EMIT_ARR_START" Condition="wantArrStart" x="3900" y="1190" />
      <ECTransition Source="EMIT_ARR_START" Destination="DISPATCH" Condition="1" x="3900" y="1260" />
      <ECTransition Source="DISPATCH" Destination="EMIT_ARR_STOP" Condition="wantArrStop" x="3900" y="1360" />
      <ECTransition Source="EMIT_ARR_STOP" Destination="DISPATCH" Condition="1" x="3900" y="1430" />
      <ECTransition Source="DISPATCH" Destination="START" Condition="1" x="2250" y="1400" />
    </ECC>
    <Algorithm Name="algInit" Comment="Initialize coordinator state and outputs">
      <ST><![CDATA[QO := QI;
state := 0;
traySettled := FALSE;
seenDistRun := FALSE;
seenTestRun := FALSE;
skipIdle := FALSE;
Stop1AutoRelease := AutoEnable AND AutoRelease;
CoordState := 0;
wantStartDist := FALSE;
wantStartTest := FALSE;
wantTestDone := FALSE;
wantCfgCnf := FALSE;
wantArrStart := FALSE;
wantArrStop := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algArrTmr" Comment="Mark tray arrival settled when debounce timer expires">
      <ST><![CDATA[IF state = 1 THEN
	traySettled := TrayAtStop1 AND (NOT Stop1Pass);
	state := 0;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="algReqCfg" Comment="Re-emit Stop1AutoRelease config on Conveyor startup">
      <ST><![CDATA[Stop1AutoRelease := AutoEnable AND AutoRelease;
wantCfgCnf := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algEval" Comment="Evaluate sequential Station 1 coordination state machine">
      <ST><![CDATA[skipIdle := FALSE;

IF Stop1AutoRelease <> (AutoEnable AND AutoRelease) THEN
	Stop1AutoRelease := AutoEnable AND AutoRelease;
	wantCfgCnf := TRUE;
END_IF;

IF NOT AutoEnable THEN
	IF state = 1 THEN
		wantArrStop := TRUE;
	END_IF;
	seenDistRun := FALSE;
	seenTestRun := FALSE;
	state := 0;
ELSE
	IF NOT TrayAtStop1 THEN
		traySettled := FALSE;
		IF state = 1 THEN
			wantArrStop := TRUE;
			state := 0;
		ELSIF state = 4 THEN
			state := 0;
		END_IF;
	ELSIF Stop1Pass THEN
		(* Stopper 1 is down (releasing or Pass mode): cancel settle and never start on passing tray *)
		IF state = 1 THEN
			wantArrStop := TRUE;
			traySettled := FALSE;
			state := 0;
		ELSIF state = 0 THEN
			traySettled := FALSE;
		END_IF;
	END_IF;

	IF state = 2 THEN
		(* RunningDist: wait for Distribution AutoCycle to deliver, return home & park *)
		IF NOT DistReady THEN
			seenDistRun := TRUE;
		ELSIF seenDistRun AND DistReady THEN
			seenDistRun := FALSE;
			IF TestPartPv.value AND (TestStopped OR TestComplete) THEN
				seenTestRun := FALSE;
				wantStartTest := TRUE;
				state := 3;
			ELSE
				state := 0;
				skipIdle := TRUE;
			END_IF;
		END_IF;
	ELSIF state = 3 THEN
		(* RunningTest: wait for TestingCycle pass or reject *)
		IF (NOT TestStopped) AND (NOT TestComplete) THEN
			seenTestRun := TRUE;
		ELSIF seenTestRun AND TestComplete THEN
			seenTestRun := FALSE;
			IF LastPass THEN
				wantTestDone := TRUE;
				IF TrayAtStop1 THEN
					state := 4;
				ELSE
					state := 0;
				END_IF;
			ELSE
				(* Rejected workpiece -> retry on same settled empty tray *)
				state := 0;
			END_IF;
		ELSIF seenTestRun AND TestStopped THEN
			seenTestRun := FALSE;
			state := 0;
			skipIdle := TRUE;
		END_IF;
	END_IF;

	IF (state = 0) AND (NOT skipIdle) AND TrayAtStop1 AND (NOT Stop1Pass) THEN
		IF NOT traySettled THEN
			wantArrStart := TRUE;
			state := 1;
		ELSIF PartAtStop1 THEN
			(* Pre-filled tray: latch WaitTrayLeave so DI05 dropping while leaving never triggers Station 1 *)
			state := 4;
		ELSIF DistReady AND (TestStopped OR TestComplete) THEN
			IF TestPartPv.value THEN
				(* Leftover workpiece already on Testing lift -> test it first *)
				seenTestRun := FALSE;
				wantStartTest := TRUE;
				state := 3;
			ELSE
				seenDistRun := FALSE;
				wantStartDist := TRUE;
				state := 2;
			END_IF;
		END_IF;
	END_IF;
END_IF;

CoordState := state;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrStartDist" Comment="Clear START_DIST emit flag">
      <ST><![CDATA[wantStartDist := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrStartTest" Comment="Clear START_TEST emit flag">
      <ST><![CDATA[wantStartTest := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrTestDone" Comment="Clear TEST_DONE emit flag">
      <ST><![CDATA[wantTestDone := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrCfgCnf" Comment="Clear CFG_CNF emit flag">
      <ST><![CDATA[wantCfgCnf := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrArrStart" Comment="Clear ARR_TMR_START emit flag">
      <ST><![CDATA[wantArrStart := FALSE;
]]></ST>
    </Algorithm>
    <Algorithm Name="algClrArrStop" Comment="Clear ARR_TMR_STOP emit flag">
      <ST><![CDATA[wantArrStop := FALSE;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
