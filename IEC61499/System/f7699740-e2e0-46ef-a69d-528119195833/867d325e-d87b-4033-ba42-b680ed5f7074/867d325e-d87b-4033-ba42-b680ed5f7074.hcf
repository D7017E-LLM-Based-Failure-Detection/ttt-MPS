  <DeviceHwConfigurationItem ResourceId="F5C85C593C72F0E8">
    <ConfigurationBaseItem>
      <Name>BMTM3</Name>
      <ID>F9859FD5AF932EA5</ID>
      <Type>
        <Name>BMTM3</Name>
        <Namespace>SE.IoTMx</Namespace>
      </Type>
      <ItemProperties>
        <ItemProperty>
          <Name>busid</Name>
          <Value xsi:type="xsd:string">TM3Config</Value>
          <HWParameters>
            <string>BUS_ID</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>powerConsumption</Name>
          <Value xsi:type="xsd:unsignedByte">0</Value>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletime</Name>
          <Value xsi:type="xsd:string">T#80ms</Value>
          <HWParameters>
            <string>busCycleTime</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycletolerance</Name>
          <Value xsi:type="xsd:unsignedInt">30</Value>
          <HWParameters>
            <string>busCycleTolerance</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>buscycleactionwhenmissed</Name>
          <Value xsi:type="xsd:unsignedInt">1</Value>
          <HWParameters>
            <string>busCycleActionWhenMissed</string>
          </HWParameters>
        </ItemProperty>
        <ItemProperty>
          <Name>enableSymlinkOC</Name>
          <Value xsi:type="xsd:boolean">true</Value>
          <HWParameters>
            <string>enableSymlinkOC</string>
          </HWParameters>
        </ItemProperty>
      </ItemProperties>
      <ParameterValues>
        <ParameterValue Name="busId" Value="'BMTM3'" Comment="Uniquely identifies a bus in a device" />
        <ParameterValue Name="enableSymlinkOC" Value="TRUE" Comment="If TRUE, Symlink variables are relearnt during OnlineChange" />
        <ParameterValue Name="phase" Value="T#0ms" Comment="Delay before starting the bus events at application start to avoid same phase. Please apply a different phase for each bus master to avoid having all events processed in the same time phase." />
        <ParameterValue Name="busCycleTime" Value="T#80ms" Comment="Period at which the bus is scheduled (RX/TX)" />
        <ParameterValue Name="busCycleTolerance" Value="30" Comment="Tolerance expressed as percentage of the bus cycle time. We consider a missed cycle if elapsed time since previous cycle &gt; (bus cycle time + tolerance) or &lt; (bus cycle time - tolerance)." />
        <ParameterValue Name="busCycleActionWhenMissed" Value="1" Comment="Action to trigger on missed bus cycle. INFO to log warning with lower impact on performances (indicates how many bus cycle(s) were missed) ; DEBUG to log detailed warning with higher impact on performance (indicates exact drift for each missed cycle) ; ERROR_HALT to log an error and move to Error Halt state" />
        <ParameterValue Name="busStatusSymlink" Value="" Comment="Get bus Status via Symlink" IsSymlink="true" />
      </ParameterValues>
      <MasterConfigFileName>${ProjectDir}\${SystemName}\RuntimeData\${DeviceName}\boot\${busid}.xml</MasterConfigFileName>
