<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="81ad6192-7926-4572-abef-8de2ea991574" Name="ConveyorStationCtrl" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author=" " Date="7/2/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event ID="FCA1493C7F8C90F2" Name="INIT" Comment="Initialization Request">
        <With Var="tray" />
        <With Var="workpiece" />
        <With Var="stopperReleased" />
        <With Var="skipStation" />
      </Event>
      <Event ID="B63D93763451D8D2" Name="REQ" Comment="Normal Execution Request">
        <With Var="tray" />
        <With Var="workpiece" />
        <With Var="stopperReleased" />
        <With Var="skipStation" />
      </Event>
      <Event ID="BA222DF33F156C82" Name="REQ_RELEASE" />
    </EventInputs>
    <EventOutputs>
      <Event ID="51DD6C4097225A55" Name="INITO" Comment="Initialization Confirm">
        <With Var="releaseStopper" />
        <With Var="requestMotor" />
      </Event>
      <Event ID="020C53976EDC5F83" Name="CNF" Comment="Execution Confirmation">
        <With Var="releaseStopper" />
        <With Var="requestMotor" />
      </Event>
      <Event ID="479D8BAF37CB705B" Name="INDICATE_TRAY_STATUS">
        <With Var="Tray" />
        <With Var="Workpiece" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration ID="80FDBD11917DD7E8" Name="tray" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration ID="35D84DC527DE9C7A" Name="workpiece" Type="BOOL" />
      <VarDeclaration ID="E36855E1434FAC4E" Name="stopperReleased" Type="BOOL" />
      <VarDeclaration ID="4B293AB417BA98BC" Name="skipStation" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration ID="44FA6B7EFF537476" Name="releaseStopper" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration ID="E7A606295B977484" Name="requestMotor" Type="BOOL" />
      <VarDeclaration ID="DE4B3089F63AA198" Name="Tray" Type="BOOL" />
      <VarDeclaration ID="142F3813FF8D90F1" Name="Workpiece" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,REQ,skip,indicate_no_tray,request_motor,check_tray,cancel_motor_request,release_tray" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="INIT" Comment="Initialization" x="1146.196" y="631.8432">
        <ECAction Algorithm="INIT" Output="INITO" />
        <ECAction Algorithm="indicate_no_tray" Output="INDICATE_TRAY_STATUS" />
      </ECState>
      <ECState Name="SKIP" x="1946.667" y="406.6667">
        <ECAction Algorithm="skip" Output="CNF" />
      </ECState>
      <ECState Name="WAIT_FOR_TRAY" x="866.6666" y="1020">
        <ECAction Algorithm="request_motor" Output="CNF" />
      </ECState>
      <ECState Name="EMPTY_TRAY" x="799.9999" y="1493.333">
        <ECAction Algorithm="check_tray" Output="INDICATE_TRAY_STATUS" />
        <ECAction Algorithm="cancel_motor_request" Output="CNF" />
      </ECState>
      <ECState Name="FULL_TRAY" x="1260" y="1893.333">
        <ECAction Algorithm="check_tray" Output="INDICATE_TRAY_STATUS" />
      </ECState>
      <ECState Name="RELEASE_TRAY" x="786.6666" y="2353.333">
        <ECAction Algorithm="release_tray" Output="CNF" />
        <ECAction Algorithm="indicate_no_tray" Output="INDICATE_TRAY_STATUS" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="INIT" x="896.7343" y="457.3969">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="209.6178,105.2949,240.5746,115.858" />
      </ECTransition>
      <ECTransition Source="INIT" Destination="SKIP" Condition="skipStation" x="1546.015" y="436.9295">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="362.3411,111.6189,412.0491,97.83613" />
      </ECTransition>
      <ECTransition Source="SKIP" Destination="WAIT_FOR_TRAY" Condition="NOT skipStation" x="1958.591" y="598.6388">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="562.3364,120.0299,487.6508,162.444" />
      </ECTransition>
