        <Attribute Name="Configuration.Transaction.BezierPoints" Value="194.6495,173.045,177.6186,196.6944" />
      </ECTransition>
      <ECTransition Source="WAIT_FOR_TRAY" Destination="FULL_TRAY" Condition="tray AND workpiece" x="2502.987" y="1365.463">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="712.1822,302.673,741.0429,366.7537" />
      </ECTransition>
      <ECTransition Source="WAIT_FOR_TRAY" Destination="EMPTY_TRAY" Condition="tray AND NOT workpiece" x="915.169" y="1267.127">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="235.2543,302.2797,230.9237,333.027" />
      </ECTransition>
      <ECTransition Source="EMPTY_TRAY" Destination="FULL_TRAY" Condition="workpiece" x="1096.815" y="1636.738">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="259.7386,392.15,288.0703,416.7863" />
      </ECTransition>
      <ECTransition Source="FULL_TRAY" Destination="EMPTY_TRAY" Condition="tray AND NOT workpiece" x="1021.983" y="1768.333">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="271.6659,460.6514,243.3341,436.0151" />
      </ECTransition>
      <ECTransition Source="FULL_TRAY" Destination="RELEASE_TRAY" Condition="REQ_RELEASE" x="1088.916" y="2177.118">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="288.5043,533.9435,258.009,563.5798" />
      </ECTransition>
      <ECTransition Source="RELEASE_TRAY" Destination="WAIT_FOR_TRAY" Condition="NOT tray" x="106.5859" y="1572.224">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="-26.60362,434.726,-20.45877,332.312" />
      </ECTransition>
      <ECTransition Source="EMPTY_TRAY" Destination="RELEASE_TRAY" Condition="REQ_RELEASE" x="532.9241" y="1911.301">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="116.7311,445.3377,115.7549,508.3074" />
      </ECTransition>
    </ECC>
    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[requestMotor := FALSE;
releaseStopper := FALSE;
Tray := FALSE;
Workpiece := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST><![CDATA[;]]></ST>
    </Algorithm>
    <Algorithm Name="skip">
      <ST><![CDATA[releaseStopper := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="indicate_no_tray">
      <ST><![CDATA[Tray := FALSE;
Workpiece := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="request_motor">
      <ST><![CDATA[requestMotor := TRUE;
releaseStopper := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="check_tray">
      <ST><![CDATA[Tray := tray;
Workpiece := workpiece;]]></ST>
    </Algorithm>
    <Algorithm Name="cancel_motor_request">
      <ST><![CDATA[requestMotor := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="release_tray">
      <ST><![CDATA[releaseStopper := TRUE;
requestMotor := TRUE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>